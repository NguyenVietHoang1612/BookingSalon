@using BookingSalon.Areas.Admin.Models
@using BookingSalon.Data.Repository
@model PaginatedList<UserViewModel>

@{
    ViewData["title"] = "Danh sách người dùng";

    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<style>
    .avatar-wrapper {
        width: 100px;
        height: 100px;
        flex-shrink: 0;
    }

        .avatar-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .text-truncate {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<div class="container-fluid py-2 px-md-5">
    <div class="card main-card p-2 p-lg-4">
        <div class="row align-items-center mb-5">
                <div class="d-flex justify-content-between align-items-center col-xl-6 col-lg-5">
                    <h2 class="fw-bold text-primary">Quản lý người dùng</h2>
                </div>

                <div class="col-xl-6 col-lg-7">
                    <div class="row g-3 justify-content-lg-end">
                        <div class="col-sm-7 col-12">
                            <form asp-action="Index" method="get">
                                <div class="input-group search-group">
                                    <input type="text" name="term" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tìm kiếm theo tên loại dịch vụ...">
                                    <button type="submit" class="btn border"><i class="bi bi-search"></i></button>
                                </div>
                            </form>
                        </div>
                        <div class="col-sm-5 col-12 d-grid">
                            <a class="btn btn-primary shadow-sm text-decoration-none text-white" asp-controller="Users" asp-action="Create">
                                <i class="bi bi-plus-lg me-2"></i>
                                Thêm người dùng
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-light py-2 border-bottom-0 d-flex justify-content-between">
                                <small class="text-muted fw-bold fst-italic">
                                    @(item.User.EmailConfirmed ? "Đã kích hoạt" : "Chưa kích hoạt")
                                </small>

                                <small class="text-muted fw-bold fst-italic">
                                    @(item.User.Status ? "" : "Đã chặn")
                                </small>
                            </div>

                            <div class="card-body pt-1">
                                <div class="row g-0">
                                    @* Dùng row g-0 để chia không gian chính xác *@
                                    <div class="col-8 pe-2">
                                        <h5 class="fw-bold mb-1 text-truncate" title="@item.User.FullName">
                                            @(item.User.FullName ?? "Unnamed")
                                        </h5>
                                        <p class="small text-muted mb-2 text-truncate">
                                            <strong>About:</strong> @item.RoleName
                                        </p>

                                        <div class="d-flex align-items-start mb-1 overflow-hidden">
                                            <i class="bi bi-geo-alt-fill text-muted me-1 small"></i>
                                            <p class="small mb-0 text-truncate"><strong>Id:</strong> @item.User.Id</p>
                                        </div>

                                        <div class="d-flex align-items-start mb-1 overflow-hidden">
                                            <i class="bi bi-geo-alt-fill text-muted me-1 small"></i>
                                            <p class="small mb-0 text-truncate"><strong>Email:</strong> @item.User.Email</p>
                                        </div>

                                        <div class="d-flex align-items-start overflow-hidden">
                                            <i class="bi bi-telephone-fill text-muted me-1 small"></i>
                                            <p class="small mb-0 text-truncate"><strong>Phone:</strong> @item.User.PhoneNumber</p>
                                        </div>

                                        <div class="d-flex align-items-start mb-1 overflow-hidden">
                                            <i class="bi bi-geo-alt-fill text-muted me-1 small"></i>
                                            <p class="small mb-0 text-truncate"><strong>Địa chỉ:</strong> @item.User.Address</p>
                                        </div>
                                    </div>

                                    <div class="col-4 d-flex justify-content-center align-items-start">
                                        <div class="avatar-wrapper">
                                            <img src="@(string.IsNullOrEmpty(item.User.Avatar_Name)
                                                     ? "https://ui-avatars.com/api/?name=" + item.User.FullName
                                                     : Url.Content("~/media/users/" + item.User.Avatar_Name))"
                                             class="rounded-circle border"
                                             alt="Avatar">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 pb-3">
                                <a asp-action="Update" asp-route-Id="@item.User.Id" class="btn btn-warning btn-sm px-3 fw-bold text-dark shadow-sm text-decoration-none">
                                    <i class="bi bi-slash-circle"></i> Cập nhật
                                </a>

                                <form id="delete-form-@item.User.Id" asp-action="SoftDelete" asp-route-id="@item.User.Id" method="post" class="m-0">
                                    <button type="button" class="btn btn-danger btn-sm px-3 fw-bold shadow-sm" onclick="confirmDelete('@Url.Action("SoftDelete", "Users", new { id = item.User.Id })', '@item.User.Email')">
                                        <i class="bi bi-x-lg"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        <div class="row align-items-center mt-3">
            <div class="col-sm-6 text-muted">
                Hiển thị trang <b>@Model.PageIndex</b> / Trong tổng số <b>@Model.TotalPages</b> trang
            </div>
            <div class="col-sm-6">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">

                        <li class="page-item @prevDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>

                        <li class="page-item @prevDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            // Logic để chỉ hiển thị một vài số trang nếu tổng số quá lớn
                            if (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-term="@ViewBag.SearchTerm">@i</a>
                                </li>
                            }
                        }

                        <li class="page-item @nextDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>

                        <li class="page-item @nextDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

