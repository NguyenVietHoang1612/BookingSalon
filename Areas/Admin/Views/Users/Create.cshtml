@using BookingSalon.Areas.Admin.Models
@model UserCreateViewModel

@{
    ViewData["title"] = "Thêm người dùng";
}


<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý Người dùng</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Thêm người dùng mới</h5>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Họ và tên</label>
                        <input asp-for="User.FullName" class="form-control" placeholder="Nhập họ tên" />
                        <span asp-validation-for="User.FullName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input asp-for="User.Email" class="form-control" placeholder="Nhập email" />
                        <span asp-validation-for="User.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Số điện thoại </label>
                        <input asp-for="User.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                        <span asp-validation-for="User.PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Địa chỉ đang ở</label>
                        <input asp-for="User.Address" class="form-control" placeholder="Nhập địa chỉ" />
                        <span asp-validation-for="User.Address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Tên vai trò</label>
                        <select asp-for="User.RoleId" asp-items="ViewBag.Roles" class="form-control">
                            <option value="">Chọn vai trò</option>
                        </select>
                        <span asp-validation-for="User.RoleId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Xác minh tài khoản</label>
                        <select class="form-control form-label fw-semibold" asp-for="User.EmailConfirmed">
                                <option value="true">Kích hoạt tài khoản</option>
                                <option value="false">Không kích hoạt tài khoản</option>
                            </select>
                        <span asp-validation-for="User.EmailConfirmed" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select asp-for="User.Status" class="form-control">
                            <option value="true">Hủy chặn tài khoản</option>
                            <option value="false">Chặn tài khoản</option>
                        </select>

                        <span asp-validation-for="User.Status" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Thêm ảnh avatar</label>
                        <input asp-for="User.Avatar_Image_Upload" class="form-control" placeholder="Chọn ảnh" />
                        <span asp-validation-for="User.Avatar_Image_Upload" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-add fw-bold">
                            <i class="bi bi-plus-lg me-2"></i> Thêm mới
                        </button>

                        <a asp-action="Index" class="btn btn-danger fw-bold">
                            <i class="bi bi-x-lg me-2">Hủy thêm mới</i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

