@using BookingSalon.Areas.Admin.Models.ViewModel
@model UserCreateViewModel

@{
    ViewData["title"] = "Thêm mới khách hàng";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5 shadow-sm border-0" style="border-radius: 15px;">
        <div class="d-flex">
            <h2 class="fw-bold text-primary"><i class="bi bi-person-plus me-2"></i>Thêm mới khách hàng</h2>
        </div>

        <div class="form-section">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">
                    <i class="bi bi-person-vcard me-2 text-primary"></i>
                    Thông tin cá nhân & Tài khoản
                </h5>

                <div class="row g-4 mb-5">
                    <div class="col-12 col-md-6 col-lg-4 text-center border-end">
                        <label class="form-label d-block fw-semibold">Ảnh đại diện</label>
                        <div class="mb-3 position-relative">
                            <img src="~/img/default-avatar.png"
                                 id="previewAvatar"
                                 class="rounded-circle img-thumbnail shadow-sm"
                                 style="width: 150px; height: 150px; object-fit: cover;" />
                        </div>
                        <div class="px-3">
                            <input asp-for="User.Avatar_Image_Upload" type="file" class="form-control form-control-sm"
                                   accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="User.Avatar_Image_Upload" class="text-danger small"></span>
                            <div class="form-text mt-2 small">Định dạng hỗ trợ: JPG, PNG, JPEG</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-8">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="User.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="User.FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input asp-for="User.Email" type="email" class="form-control" placeholder="example@gmail.com" />
                            <span asp-validation-for="User.Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="User.PhoneNumber" class="form-control" placeholder="090xxxxxxx" />
                            <span asp-validation-for="User.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Tỉnh / Thành phố</label>
                            <select id="ddlProvince" class="form-control" asp-items="ViewBag.Provinces">
                                <option value="">-- Chọn Tỉnh / Thành phố --</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Quận / Huyện</label>
                            <select id="ddlDistrict" class="form-control">
                                <option value="">-- Chọn Quận / Huyện --</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Phường / Xã</label>
                            <select asp-for="User.WardId" id="ddlWard" class="form-control">
                                <option value="">-- Chọn Phường / Xã --</option>
                            </select>
                            <span asp-validation-for="User.WardId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Số nhà, tên đường</label>
                            <input asp-for="User.Address" class="form-control" placeholder="Ví dụ: 123 Đường ABC" />
                            <span asp-validation-for="User.Address" class="text-danger small d-block mt-1"></span>
                        </div>

                            <input type="hidden" asp-for="User.RoleId" value="@Model.CustomerRoleId" />

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select asp-for="User.Status" class="form-control">
                                <option value="true">Hủy chặn tài khoản</option>
                                <option value="false">Chặn tài khoản</option>
                            </select>
                            <span asp-validation-for="User.Status" class="text-danger small d-block mt-1"></span>
                        </div>

                    </div>
                </div>
                </div>

                <hr class="my-5" />

                <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">
                    <i class="bi bi-gem me-2 text-warning"></i>
                    Thiết lập hạng khách hàng ban đầu
                </h5>
                <div class="row g-4">
                    <input type="hidden" asp-for="CustomerRank.Customer_Id" value="@Model.User?.Id" />
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Điểm tích lũy hiện tại</label>
                        <input asp-for="CustomerRank.CurrentPoints" type="number" class="form-control" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Tổng điểm trọn đời</label>
                        <input asp-for="CustomerRank.LifetimePoints" type="number" class="form-control" value="0" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="CustomerRank.Is_Active" checked>
                            <label class="form-check-label fw-semibold" asp-for="CustomerRank.Is_Active">Kích hoạt hạng thành viên</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 d-flex gap-3 mt-5 pt-3">
                    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
                        <i class="bi bi-person-check-fill me-2"></i> Lưu khách hàng
                    </button>
                    <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                        <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-switch .form-check-input {
            width: 3.5rem !important;
            height: 1.75rem !important;
            cursor: pointer;
        }

        .custom-switch-container {
            display: flex;
            align-items: center;
            height: 38px; 
        }

        .form-check-label {
            margin-left: 10px;
            cursor: pointer;
            user-select: none;
        }

        .choices__inner {
            border-radius: 0.375rem !important;
            min-height: calc(1.5em + 0.75rem + 2px);
            padding: 0.375rem 0.75rem;
        }

        .choices__list--dropdown {
            border-radius: 0.375rem;
        }
    </style>
        
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/ChoicesSelectList.js"></script>

    <script>
        var provinceChoices, districtChoices, wardChoices;
        $(document).ready(function () {
            provinceChoices = initSelectSearch('ddlProvince', 'Chọn Tỉnh / Thành phố...');
            districtChoices = initSelectSearch('ddlDistrict', 'Chọn Quận / Huyện...');
            wardChoices = initSelectSearch('ddlWard', 'Chọn Phường / Xã...');

            $('#ddlProvince').on('change', function () {
                var pId = $(this).val();

                districtChoices.clearStore();
                districtChoices.setChoices([{ value: '', label: '-- Chọn Quận/Huyện --', selected: true }]);
                wardChoices.clearStore();
                wardChoices.setChoices([{ value: '', label: '-- Chọn Phường/Xã --', selected: true }]);

                if (pId) {
                    $.getJSON('/Admin/Users/GetDistricts', { provinceId: pId }, function (data) {
                        var choicesData = data.map(item => ({
                            value: item.id.toString(),
                            label: item.name,
                            selected: false
                        }));
                        districtChoices.setChoices(choicesData, 'value', 'label', false);
                    });
                }
            });

            $('#ddlDistrict').on('change', function () {
                var dId = $(this).val();

                wardChoices.clearStore();
                wardChoices.setChoices([{ value: '', label: '-- Chọn Phường/Xã --', selected: true }]);

                if (dId) {
                    $.getJSON('/Admin/Users/GetWards', { districtId: dId }, function (data) {
                        var choicesData = data.map(item => ({
                            value: item.id.toString(),
                            label: item.name,
                            selected: false
                        }));
                        wardChoices.setChoices(choicesData, 'value', 'label', false);
                    });
                }
            });
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewAvatar').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}