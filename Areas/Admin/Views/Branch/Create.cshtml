@using BookingSalon.Areas.Admin.Models.ViewModel
@model ComboViewModel

@{
    ViewData["title"] = "Thêm Combo";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý Combo</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-plus-circle me-2"></i>Thêm combo mới</h5>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 col-lg-4 border-end">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên combo</label>
                            <input asp-for="ComboModel.ComboName" class="form-control" placeholder="Nhập tên combo" />
                            <span asp-validation-for="ComboModel.ComboName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tổng thời lượng (phút)</label>
                            <input asp-for="ComboModel.TotalDuration" type="number" id="totalDuration" class="form-control bg-light" readonly />
                            <small class="text-muted italic">* Tự động tính theo dịch vụ</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Giá gốc (đ)</label>
                            <input asp-for="ComboModel.BasePrice" type="number" id="basePrice" class="form-control bg-light" readonly />
                            <small class="text-muted italic">* Tổng giá các dịch vụ đã chọn</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-danger">Giá khuyến mãi (đ)</label>
                            <input asp-for="ComboModel.PromotionPrice" type="number" class="form-control border-danger" placeholder="Nhập giá bán thực tế" />
                            <span asp-validation-for="ComboModel.PromotionPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12 col-lg-8">
                        <label class="form-label fw-semibold mb-3">Danh sách dịch vụ đơn lẻ <span class="text-primary">(Chọn để tạo combo)</span></label>
                        <div class="row g-2" style="max-height: 450px; overflow-y: auto; border: 1px solid #eee; padding: 10px; border-radius: 8px;">
                            @if (Model.Services != null)
                            {
                                foreach (var svc in Model.Services)
                                {
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded shadow-sm d-flex align-items-center">
                                            <div class="form-check w-100">
                                                <input class="form-check-input svc-checkbox" type="checkbox"
                                                       name="selectedServices" value="@svc.ServiceId"
                                                       id="svc-@svc.ServiceId"
                                                       data-price="@svc.Base_Price"
                                                       data-duration="@svc.DurationInMinutes">
                                                <label class="form-check-label ms-2 d-block" for="svc-@svc.ServiceId">
                                                    <div class="fw-bold">@svc.Service_Name</div>
                                                    <div class="small text-muted">
                                                        <span><i class="bi bi-clock me-1"></i>@svc.DurationInMinutes phút</span> |
                                                        <span class="text-primary">@svc.Base_Price.ToString("N0")đ</span>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="mt-4 p-3 bg-light rounded d-flex justify-content-between align-items-center">
                            <div>
                                <span class="me-3">Tổng thời gian: <strong id="displayDuration">0</strong> phút</span>
                            </div>
                            <div>
                                <span class="fw-bold text-dark">Tạm tính giá gốc: <span id="tempTotal" class="text-primary">0</span>đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-5">
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-save me-2"></i> Tạo combo
                    </button>
                    <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                        <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('.svc-checkbox').on('change', function() {
                let totalPrice = 0;
                let totalTime = 0;

                $('.svc-checkbox:checked').each(function() {
                    let price = parseFloat($(this).data('price')) || 0;
                    let duration = parseInt($(this).data('duration')) || 0;

                    totalPrice += price;
                    totalTime += duration;
                });

                $('#basePrice').val(totalPrice);
                $('#totalDuration').val(totalTime);

                // Cập nhật text hiển thị cho người dùng
                $('#tempTotal').text(totalPrice.toLocaleString('vi-VN'));
                $('#displayDuration').text(totalTime);
            });
        });
    </script>
}