@using BookingSalon.Models.Entities
@model Branch

@{
    ViewData["title"] = "Cập nhật chi nhánh";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý chi nhánh</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Cập nhật chi nhánh</h5>

            <form asp-action="Update">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Tên chi nhánh</label>
                            <input asp-for="Branch_Name" class="form-control" placeholder="Nhập tên chi nhánh" />
                            <span asp-validation-for="Branch_Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Địa chỉ chi nhánh</label>
                            <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ" />
                            <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Số điện thoại chi nhánh</label>
                            <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Chi nhánh hoạt động</label>
                            <select asp-for="Status" class="form-control">
                                <option value="true">Chi nhánh hoạt động</option>
                                <option value="false">Chi nhánh không hoạt động</option>
                            </select>

                            <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-add fw-bold">
                                <i class="bi bi-plus-lg me-2"></i> Hoản tất cập nhật
                            </button>

                            <a asp-action="Index" class="btn btn-danger fw-bold">
                                <i class="bi bi-x-lg me-2">Hủy cập nhật</i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}