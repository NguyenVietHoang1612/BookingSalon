@using BookingSalon.Models.Entities
@model BranchModel

@{
    ViewData["title"] = "Cập nhật chi nhánh";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý chi nhánh</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Cập nhật chi nhánh mới</h5>

            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Tên chi nhánh</label>
                        <input asp-for="Branch_Name" class="form-control" placeholder="Nhập tên chi nhánh" />
                        <span asp-validation-for="Branch_Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Tỉnh / Thành phố</label>
                        <select id="ddlProvince" class="form-control" asp-items="ViewBag.Provinces">
                            <option value="">-- Chọn Tỉnh / Thành phố --</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Quận / Huyện</label>
                        <select id="ddlDistrict" class="form-control">
                            <option value="">-- Chọn Quận / Huyện --</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Phường / Xã</label>
                        <select asp-for="WardId" id="ddlWard" class="form-control">
                            <option value="">-- Chọn Phường / Xã --</option>
                        </select>
                        <span asp-validation-for="WardId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-6">
                        <label class="form-label fw-semibold">Số nhà, tên đường</label>
                        <input asp-for="Address" class="form-control" placeholder="Ví dụ: 123 Đường ABC" />
                        <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Số điện thoại chi nhánh</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Thêm ảnh chi nhánh</label>
                        <input asp-for="Branch_Image_Upload" class="form-control" placeholder="Chọn ảnh" />
                        <span asp-validation-for="Branch_Image_Upload" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Trạng thái hoạt động</label>
                        <select asp-for="Status" class="form-control">
                            <option value="true">Chi nhánh hoạt động</option>
                            <option value="false">Chi nhánh không hoạt động</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Có phải trụ sở chính không?</label>
                        <select asp-for="Is_Main_Branch" class="form-control">
                            <option value="true">Có</option>
                            <option value="false">Không</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-5">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save me-2"></i> Cập nhật thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                            <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/ChoicesSelectList.js"></script>

    <script>
        var provinceChoices, districtChoices, wardChoices;

        $(document).ready(function () {
            provinceChoices = initSelectSearch('ddlProvince', 'Chọn Tỉnh / Thành phố...');
            districtChoices = initSelectSearch('ddlDistrict', 'Chọn Quận / Huyện...');
            wardChoices = initSelectSearch('ddlWard', 'Chọn Phường / Xã...');

            $('#ddlProvince').on('change', function () {
                var pId = $(this).val();

                districtChoices.clearStore();
                districtChoices.setChoices([{ value: '', label: '-- Chọn Quận/Huyện --', selected: true }]);
                wardChoices.clearStore();
                wardChoices.setChoices([{ value: '', label: '-- Chọn Phường/Xã --', selected: true }]);

                if (pId) {
                    $.getJSON('/Admin/Branch/GetDistricts', { provinceId: pId }, function (data) {
                        var choicesData = data.map(item => ({
                            value: item.id.toString(),
                            label: item.name,
                            selected: false
                        }));
                        districtChoices.setChoices(choicesData, 'value', 'label', false);
                    });
                }
            });

            $('#ddlDistrict').on('change', function () {
                var dId = $(this).val();

                wardChoices.clearStore();
                wardChoices.setChoices([{ value: '', label: '-- Chọn Phường/Xã --', selected: true }]);

                if (dId) {
                    $.getJSON('/Admin/Branch/GetWards', { districtId: dId }, function (data) {
                        var choicesData = data.map(item => ({
                            value: item.id.toString(),
                            label: item.name,
                            selected: false
                        }));
                        wardChoices.setChoices(choicesData, 'value', 'label', false);
                    });
                }
            });
        });
    </script>
}
