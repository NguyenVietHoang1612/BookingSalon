@using BookingSalon.Models.Entities
@model CouponModel

@{
    ViewData["title"] = "Thêm mã giảm giá";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý mã giảm giá</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark">
                <i class="bi bi-ticket-perforated me-2"></i>Thêm mã giảm giá mới
            </h5>

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Tên code giảm giá</label>
                        <input asp-for="Code" class="form-control"
                               placeholder="Ví dụ: SALE50, NEWUSER..." />
                        <span asp-validation-for="Code"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Chọn thể loại giảm giá</label>
                        <select asp-for="Discount_Type"
                                asp-items="Html.GetEnumSelectList<DiscountType>()"
                                class="form-control">
                        </select>
                        <span asp-validation-for="Discount_Type"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Giá trị giảm giá</label>
                        <div class="input-group">
                            <input asp-for="Discount_value"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Nhập giá trị giảm" />
                            <span class="input-group-text"
                                  id="discountUnit"></span>
                        </div>
                        <span asp-validation-for="Discount_value"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Giá trị tối thiểu sử dụng</label>
                        <div class="input-group">
                            <input asp-for="Min_Order_Amount"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Ví dụ một đơn: 200000" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Min_Order_Amount"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Số lượt sử dụng tối đa</label>
                        <div class="input-group">
                            <input asp-for="Usage_Limit"
                                   type="number"
                                   class="form-control" />
                            <span class="input-group-text">Lượt</span>
                        </div>
                        <span asp-validation-for="Usage_Limit"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Giới hạn số lượt khách hàng sử dụng</label>
                        <input asp-for="MaxUsagePerUser"
                               type="number"
                               class="form-control"
                               placeholder="Để trống nếu không giới hạn. Vd: 1 khách hàng -> 1" />
                        <span asp-validation-for="MaxUsagePerUser"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Ngày hết hạn</label>
                        <input asp-for="Expires_At"
                               type="datetime-local"
                               class="form-control" />
                        <span asp-validation-for="Expires_At"
                              class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Trạng thái hoạt động</label>
                        <select asp-for="IsActive" class="form-control">
                            <option value="true">Kích hoạt mã coupon</option>
                            <option value="false">Không kích hoạt mã coupon</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-5">
                        <button type="submit"
                                class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save me-2"></i> Thêm mã giảm giá
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-danger fw-bold px-4">
                            <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>


@section Styles {
    <style>
        .form-switch .form-check-input {
            width: 3.5rem !important;
            height: 1.75rem !important;
            cursor: pointer;
        }
    </style>

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const typeSelect = document.querySelector('[name="Discount_Type"]');
        const unit = document.getElementById('discountUnit');

        function updateUnit() {
            if (typeSelect.value == "0") {
                unit.innerText = "%";
            } else {
                unit.innerText = "VNĐ";
            }
        }

        updateUnit();
        typeSelect.addEventListener('change', updateUnit);
    </script>
}