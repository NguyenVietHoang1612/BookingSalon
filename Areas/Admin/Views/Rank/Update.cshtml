@using BookingSalon.Models.Entities
@model RankModel

@{
    ViewData["title"] = "Cập nhật hạng thành viên";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý hạng thành viên</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark">
                <i class="bi bi-pencil-square me-2"></i>Cập nhật thông tin hạng: <span class="text-primary">@Model.RankName</span>
            </h5>

            <form asp-action="Update" method="post">
                <input type="hidden" asp-for="RankId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Tên hạng thành viên</label>
                        <input asp-for="RankName" class="form-control" placeholder="Ví dụ: Bạc, Vàng, Kim cương..." />
                        <span asp-validation-for="RankName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Mốc điểm tối thiểu</label>
                        <div class="input-group">
                            <input asp-for="MinPoint" type="number" class="form-control" />
                            <span class="input-group-text">Pts</span>
                        </div>
                        <span asp-validation-for="MinPoint" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Phần trăm chiết khấu (%)</label>
                        <div class="input-group">
                            <input asp-for="DiscountPercent" type="number" step="0.1" class="form-control" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="DiscountPercent" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold">Số ngày đặt trước tối đa</label>
                        <div class="input-group">
                            <input asp-for="MaxBookingDays" type="number" class="form-control" />
                            <span class="input-group-text">Ngày</span>
                        </div>
                        <span asp-validation-for="MaxBookingDays" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-lg-8">
                        <label class="form-label fw-semibold">Mô tả đặc quyền</label>
                        <textarea asp-for="Description" class="form-control" rows="1">@Model.Description</textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-5">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save me-2"></i> Cập nhật thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                            <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

}