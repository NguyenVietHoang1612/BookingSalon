@using BookingSalon.Models.ViewModel.BookingSalonViewModel
@using System.Globalization
@using BookingSalon.Data.Repository
@model PaginatedList<BookingProfileDetailsViewModel>

@{
    ViewData["title"] = "Danh dách Booking";
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<div class="container-fluid py-2 px-md-5">
    <div class="card main-card p-2 p-lg-4">
        <div class="row align-items-center mb-5">
                <div class="col-xl-6 col-lg-5">
                    <h2 class="title-main mb-lg-0 mb-3">Quản lý Booking</h2>
                </div>
                <div class="col-xl-6 col-lg-7">
                    <div class="row g-3 justify-content-lg-end">
                        <div class="col-sm-7 col-12">
                            <form asp-action="Index" method="get">
                                <div class="input-group search-group">
                                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tìm kiếm theo tên...">
                                    <button type="submit" class="btn border"><i class="bi bi-search"></i></button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Địa chỉ</th>
                            <th>Id_Stylist</th>
                            <th>Stylist</th>
                            <th>Tại chi nhánh</th>
                            <th>Giờ đặt</th>
                            <th>Ngày đặt</th>
                            <th>Giá</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>

                            @* <th class="text-center"></th>
                            <th class="text-end pe-4"></th>
                            <th class="text-end pe-4"></th> *@
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@item.BookingId</td>
                                <td class="text-muted">@item.Customer_Name</td>
                                <td class="text-muted">@item.Customer_Phone</td>
                                <td class="text-muted">@item.Customer_Email</td>
                                <td class="text-muted">@item.Customer_Address</td>
                                <td class="text-muted">@item.Id_Stylist</td>
                                <td class="text-muted">@item.Stylist_Name</td>
                                <td class="text-muted">@item.Branch_Name</td>
                                <td class="text-muted">@item.TimeSlot</td>
                                <td class="text-muted">@item.Date_Booking</td>
                                <td class="text-muted">
                                    @(item.TotalPrice.HasValue? item.TotalPrice.Value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) : "0") 
                                </td>
                                <td class="text-muted">
                                    @if(item.Status == "pending")
                                    {
                                        <div class="d-flex justify-content-center align-items-center p-0 bg-warning rounded-2">Chưa xác nhận</div>
                                    }
                                    else if (item.Status == "comfirm")
                                    {
                                        <div class="d-flex justify-content-center align-items-center p-0 bg-success rounded-2">Đã xác nhận</div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-center align-items-center p-0 bg-success rounded-2">Đã hoàn thành</div>
                                    }
                            </td>
                                <td class="text-center pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Thao tác
                                        </button>
                                        <ul class="dropdown-menu">
                                            @if (item.Status == "confirm")
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-action="BookingDetails" asp-route-id="@item.BookingId">
                                                        <i class="bi bi-eye"></i> Xem chi tiết
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-action="BookingDetails" asp-route-id="@item.BookingId">
                                                        <i class="bi bi-eye"></i> Xem chi tiết
                                                    </a>
                                                </li>

                                                <li><hr class="dropdown-divider"></li>

                                                <li>
                                                    <button type="button" class="dropdown-item text-success"
                                                            onclick="updateBookingStatus('@item.BookingId', 'confirm')">
                                                        <i class="bi bi-check-circle"></i> Xác nhận
                                                    </button>
                                                </li>

                                                <li>
                                                    <button type="button" class="dropdown-item text-danger"
                                                            onclick="updateBookingStatus('@item.BookingId', 'cancel')">
                                                        <i class="bi bi-x-circle"></i> Hủy đơn
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        <div class="row align-items-center mt-3">
            <div class="col-sm-6 text-muted">
                Hiển thị trang <b>@Model.PageIndex</b> / Trong tổng số <b>@Model.TotalPages</b> trang
            </div>
            <div class="col-sm-6">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">

                        <li class="page-item @prevDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>

                        <li class="page-item @prevDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            // Logic để chỉ hiển thị một vài số trang nếu tổng số quá lớn
                            if (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-term="@ViewBag.SearchTerm">@i</a>
                                </li>
                            }
                        }

                        <li class="page-item @nextDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>

                        <li class="page-item @nextDisabled">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-term="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

@section Styles {
        <link rel="stylesheet" href="~/css/Paginated.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
