@using BookingSalon.Models.ViewModel.BookingSalonViewModel
@model BookingDetailViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Hóa đơn dịch vụ";
}

<style>
    .invoice-container {
        background-color: #fff;
        padding: 40px;
        color: #333;
    }

    .invoice-header {
        border-bottom: 2px solid #f8f9fa;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .invoice-title {
        color: #556080;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-label {
        color: #888;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .info-content {
        font-weight: 600;
        margin-bottom: 15px;
    }

    .table-invoice thead th {
        background-color: #f8f9fa;
        border-top: none;
        color: #555;
        text-transform: uppercase;
        font-size: 0.8rem;
        padding: 12px;
    }

    .table-invoice tbody td {
        padding: 15px 12px;
        border-bottom: 1px solid #eee;
    }

    .total-section {
        border-top: 2px solid #f8f9fa;
        padding-top: 20px;
    }

    .grand-total {
        color: #d9534f;
        font-size: 1.25rem;
    }

    @@media print {
        .no-print {
            display: none;
        }

        .invoice-container {
            padding: 0;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4 no-print">
        <a asp-action="Index" class="btn btn-light border rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <div>
            <button onclick="window.print()" class="btn btn-dark rounded-pill px-4">
                <i class="bi bi-printer me-2"></i> In hóa đơn
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="invoice-container">
            <div class="invoice-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="invoice-title fw-bold mb-0">Hóa đơn dịch vụ</h3>
                    <p class="text-muted mb-0">Chi tiết lịch đặt #@Model.BookingId</p>
                </div>
                <div class="text-end">
                    <img src="~/media/logo.png" alt="Salon Logo" style="height: 50px; filter: grayscale(1);" onerror="this.style.display='none'" />
                    <p class="small text-muted mt-2">Ngày: @Model.Create_At.ToString("dd-MM-yyyy")</p>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-sm-4">
                    <div class="info-label text-uppercase">Từ (Salon)</div>
                    <div class="info-content">
                        @Model.Branch_Name<br />
                        <span class="fw-normal text-muted">@Model.Branch_Address</span><br />
                        <span class="fw-normal text-muted">Stylist: @Model.Stylist_Name</span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="info-label text-uppercase">Đến (Khách hàng)</div>
                    <div class="info-content">
                        @Model.Customer_Name<br />
                        <span class="fw-normal text-muted">@Model.Customer_Phone</span><br />
                        <span class="fw-normal text-muted">@Model.Customer_Email</span>
                    </div>
                </div>
                <div class="col-sm-4 text-md-end">
                    <div class="info-label text-uppercase">Lịch hẹn</div>
                    <div class="info-content">@Model.TimeSlot | @Model.Date_Booking.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-invoice">
                    <thead>
                        <tr>
                            <th style="width: 50%">Dịch vụ</th>
                            <th class="text-center">Thời lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.bookingDetails != null)
                        {
                            foreach (var detail in Model.bookingDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">
                                            @if (!string.IsNullOrEmpty(detail.Service?.ImageName))
                                            {
                                                <img src="~/media/services/@detail.Service.ImageName" class="rounded-2 me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                            }
                                            @detail.Service?.Service_Name
                                        </div>
                                        <div class="small text-muted">@detail.Service?.TypeOfService?.Type_Service_Name</div>
                                    </td>
                                    <td class="text-center">@detail.Service?.DurationInMinutes phút</td>
                                    <td class="text-end">@detail.Service?.Price.ToString("N0") đ</td>
                                    <td class="text-end fw-bold">@detail.Service?.Price.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-5">
                    <div class="total-section">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tổng tiền dịch vụ:</span>
                            <span>@(Model.TotalPrice?.ToString("N0")) đ</span>
                        </div>
                        @* <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Thuế (0%):</span>
                            <span>0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Giảm giá:</span>
                            <span>0 đ</span>
                        </div> *@
                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <h5 class="fw-bold mb-0">TỔNG CỘNG:</h5>
                            <h4 class="fw-bold grand-total mb-0">@(Model.TotalPrice?.ToString("N0")) VNĐ</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5 pt-5 border-top">
                <div class="row">
                    <div class="col-sm-8">
                        <p class="small text-muted italic">Vui lòng hoàn tất thanh toán tại quầy sau khi sử dụng dịch vụ. Cảm ơn quý khách đã tin tưởng BookingSalon!</p>
                    </div>
                    <div class="col-sm-4 text-center d-flex flex-column justify-content-center align-content-center">
                        <div class="info-label text-uppercase mb-4">Trạng thái đơn đặt</div>

                        @{
                            var statusClass = Model.Status == "pending" ? "bg-warning" : (Model.Status == "confirm" ? "bg-success" : "bg-primary");
                            var statusText = Model.Status == "pending" ? "Chờ xác nhận" : (Model.Status == "confirm" ? "Đã xác nhận" : "Hoàn thành");
                        }

                  
                        <h5 class="fw-bold text-uppercase bg-success rounded-2 text-white">@statusText</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>