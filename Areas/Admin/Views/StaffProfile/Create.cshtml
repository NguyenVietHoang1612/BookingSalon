@using BookingSalon.Areas.Admin.Models.ViewModel
@model StaffCombinedCreateVM

@{
    ViewData["title"] = "Thêm nhân viên mới";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5 shadow-sm border-0" style="border-radius:15px;">
        <div class="d-flex">
            <h2 class="fw-bold text-primary">
                <i class="bi bi-person-badge-fill me-2"></i>Thêm nhân viên mới
            </h2>
        </div>
        <div class="form-section">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">
                    <i class="bi bi-person-vcard me-2 text-primary"></i>
                    Thông tin tài khoản & cá nhân
                </h5>

                <div class="row g-4 mb-5">
                    <div class="col-12 col-md-4 text-center border-end">
                        <label class="form-label fw-semibold d-block">Ảnh đại diện</label>

                        <img src="~/img/default-avatar.png"
                             id="previewAvatar"
                             class="rounded-circle img-thumbnail shadow-sm mb-3"
                             style="width:150px;height:150px;object-fit:cover;" />

                        <input asp-for="User.Avatar_Image_Upload"
                               type="file"
                               class="form-control form-control-sm"
                               accept="image/*"
                               onchange="previewImage(this)" />
                    </div>

                    <div class="col-12 col-md-8">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Họ và tên</label>
                                <input asp-for="User.FullName" class="form-control" />
                                <span asp-validation-for="User.FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email (Tên đăng nhập)</label>
                                <input asp-for="User.Email" type="email" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="User.Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mật khẩu</label>

                                <div class="input-group">
                                    <input asp-for="Password"
                                           id="passInput"
                                           type="password"
                                           class="form-control"
                                           autocomplete="new-password" />

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            onclick="togglePass()">
                                        <i id="toggleIcon" class="bi bi-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại</label>
                                <input asp-for="User.PhoneNumber" class="form-control" />
                                <span asp-validation-for="User.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold">Tỉnh / Thành phố</label>
                                <select id="ddlProvince" class="form-control" asp-items="ViewBag.Provinces">
                                    <option value="">-- Chọn Tỉnh / Thành phố --</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold">Quận / Huyện</label>
                                <select id="ddlDistrict" class="form-control">
                                    <option value="">-- Chọn Quận / Huyện --</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold">Phường / Xã</label>
                                <select asp-for="User.WardId" id="ddlWard" class="form-control">
                                    <option value="">-- Chọn Phường / Xã --</option>
                                </select>
                                <span asp-validation-for="User.WardId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Chức vụ / Quyền</label>
                                <select asp-for="User.RoleId"
                                        class="form-control"
                                        asp-items="Model.RoleSelectList">
                                    <option value="">-- Chọn quyền hạn --</option>
                                </select>
                                <span asp-validation-for="User.RoleId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Trạng thái</label>
                                <select asp-for="User.Status" class="form-control">
                                    <option value="true">Hủy chặn tài khoản</option>
                                    <option value="false">Chặn tài khoản</option>
                                </select>
                                <span asp-validation-for="User.Status" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-5" />

                <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">
                    <i class="bi bi-briefcase-fill me-2 text-warning"></i>
                    Hồ sơ công việc
                </h5>

                <div class="row g-4">
                    <input type="hidden" asp-for="ProfileInfo.StaffId" value="UserInfor.User.Id" />

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Chi nhánh làm việc</label>
                        <select asp-for="ProfileInfo.Branch_Id"
                                class="form-control"
                                asp-items="Model.BranchSelectList">
                            <option value="">-- Chọn chi nhánh --</option>
                        </select>
                        <span asp-validation-for="ProfileInfo.Branch_Id" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Giờ bắt đầu</label>
                        <input asp-for="ProfileInfo.Start_Work_Time" type="time" class="form-control" />
                        <span asp-validation-for="ProfileInfo.Start_Work_Time" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Giờ kết thúc</label>
                        <input asp-for="ProfileInfo.End_Work_Time" type="time" class="form-control" />
                        <span asp-validation-for="ProfileInfo.End_Work_Time" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Giới thiệu / Kỹ năng</label>
                        <textarea asp-for="ProfileInfo.Staff_Bio"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="ProfileInfo.Staff_Bio" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-5 pt-3">
                    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
                        <i class="bi bi-save me-2"></i> Lưu nhân viên
                    </button>
                    <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                        <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-switch .form-check-input {
            width: 3.5rem !important;
            height: 1.75rem !important;
            cursor: pointer;
        }

        .custom-switch-container {
            display: flex;
            align-items: center;
            height: 38px;
        }

        .form-check-label {
            margin-left: 10px;
            cursor: pointer;
            user-select: none;
        }

        .choices__inner {
            border-radius: 0.375rem !important;
            min-height: calc(1.5em + 0.75rem + 2px);
            padding: 0.375rem 0.75rem;
        }

        .choices__list--dropdown {
            border-radius: 0.375rem;
        }
    </style>

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/ChoicesSelectList.js"></script>

    <script>
        var provinceChoices, districtChoices, wardChoices;
        $(document).ready(function () {
            provinceChoices = initSelectSearch('ddlProvince', 'Chọn Tỉnh / Thành phố...');
            districtChoices = initSelectSearch('ddlDistrict', 'Chọn Quận / Huyện...');
            wardChoices = initSelectSearch('ddlWard', 'Chọn Phường / Xã...');

            $('#ddlProvince').on('change', function () {
                var pId = $(this).val();

                districtChoices.clearStore();
                districtChoices.setChoices([{ value: '', label: '-- Chọn Quận/Huyện --', selected: true }]);
                wardChoices.clearStore();
                wardChoices.setChoices([{ value: '', label: '-- Chọn Phường/Xã --', selected: true }]);

                if (pId) {
                    $.getJSON('/Admin/StaffProfile/GetDistricts', { provinceId: pId }, function (data) {
                        var choicesData = data.map(item => ({
                            value: item.id.toString(),
                            label: item.name,
                            selected: false
                        }));
                        districtChoices.setChoices(choicesData, 'value', 'label', false);
                    });
                }
            });

            $('#ddlDistrict').on('change', function () {
                var dId = $(this).val();

                wardChoices.clearStore();
                wardChoices.setChoices([{ value: '', label: '-- Chọn Phường/Xã --', selected: true }]);

                if (dId) {
                    $.getJSON('/Admin/StaffProfile/GetWards', { districtId: dId }, function (data) {
                        var choicesData = data.map(item => ({
                            value: item.id.toString(),
                            label: item.name,
                            selected: false
                        }));
                        wardChoices.setChoices(choicesData, 'value', 'label', false);
                    });
                }
            });
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewAvatar').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

         function togglePass() {
            var x = document.getElementById("passInput");
            var icon = document.getElementById("toggleIcon");
            if (x.type === "password") {
                x.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                x.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>
}
