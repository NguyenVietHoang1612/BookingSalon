@using BookingSalon.Models.Entities
@model TypeOfServiceModel
   
@{
    ViewData["title"] = "cập nhật loại dịch vụ";
}


    <div class="container-fluid py-5 px-md-5">
        <div class="card main-card p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-primary">Quản lý loại dịch vụ</h2>
            </div>

            <div class="form-section">
                <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Cập nhật loại dịch vụ</h5>

                <form asp-action="Update">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Tên loại dịch vụ</label>
                            <input asp-for="Type_Service_Name" class="form-control" placeholder="Nhập tên loại dịch vụ" />
                            <span asp-validation-for="Type_Service_Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Vai trò làm loại dịch vụ</label>
                            <select class="form-control" asp-for="AppliedStaffRoleId" asp-items="ViewBag.Roles">
                                <option>Chọn vai trò</option>
                            </select>
                            <span asp-validation-for="Type_Service_Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 d-flex gap-2 mt-5">
                            <button type="submit" class="btn btn-primary fw-bold px-4">
                                <i class="bi bi-save me-2"></i> Cập nhật thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                                <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


