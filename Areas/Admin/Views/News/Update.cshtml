@using BookingSalon.Areas.Admin.Models.ViewModel
@model NewsVM
@{
    ViewData["title"] = "Cập nhật bài viết";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý tin tức</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa bài viết</h5>

            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                @* Lưu trữ các ID cần thiết *@
                <input type="hidden" asp-for="News.Id" />
                <input type="hidden" asp-for="News.AuthorId" />
                <input type="hidden" asp-for="News.Thumbnail" />

                <div class="row g-4">
                    <div class="col-12 col-md-8">
                        <label class="form-label fw-semibold">Tiêu đề bài viết</label>
                        <input asp-for="News.Title" class="form-control" placeholder="Nhập tiêu đề..." />
                        <span asp-validation-for="News.Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Trạng thái hiển thị</label>
                        <select asp-for="News.IsActive" class="form-control">
                            <option value="true">Hiển thị</option>
                            <option value="false">Ẩn (Nháp)</option>
                        </select>
                        <span asp-validation-for="News.IsActive" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Thay đổi ảnh bìa</label>
                        <input type="file" asp-for="ImageUpload" class="form-control" accept="image/*" onchange="previewImage(this)" />
                        <span asp-validation-for="ImageUpload" class="text-danger small mt-1 d-block"></span>

                        <div class="mt-3">
                            <p class="small text-muted mb-1">Ảnh hiện tại:</p>
                            <img id="imgPreview" src="@(string.IsNullOrEmpty(Model.News.Thumbnail)
                                                                                 ? "https://ui-avatars.com/api/?name=News"
                                                                                 : Url.Content("~/media/news/" + Model.News.Thumbnail))"
                                 class="rounded border shadow-sm" style="width: 200px; height: 120px; object-fit: cover;" />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Mô tả ngắn (Summary)</label>
                        <textarea asp-for="News.Summary" class="form-control" rows="5" placeholder="Mô tả nội dung bài viết..."></textarea>
                        <span asp-validation-for="News.Summary" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Nội dung chi tiết</label>
                        <textarea asp-for="News.Content" id="editor" class="form-control">@Model.News.Content</textarea>
                        <span asp-validation-for="News.Content" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-5">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save me-2"></i> Cập nhật bài viết
                        </button>
                        <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                            <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <style>
        .ck-editor__editable_inline {
            min-height: 450px;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            ClassicEditor
                .create(document.querySelector('#editor'), {
                    // Thêm cấu hình upload ảnh ở đây
                    ckfinder: {
                        uploadUrl: '@Url.Action("UploadImage", "News", new { area = "Admin" })'
                    },
                    // Thêm 'uploadImage' vào danh sách toolbar
                    toolbar: [
                        'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList',
                        'blockQuote', 'insertTable', 'mediaEmbed', 'uploadImage', '|', 'undo', 'redo'
                    ]
                })
                .catch(error => {
                    console.error(error);
                });
        });
    </script>
}