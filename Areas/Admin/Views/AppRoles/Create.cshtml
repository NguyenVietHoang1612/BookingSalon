@using Microsoft.AspNetCore.Identity
@model IdentityRole

@{
    ViewData["title"] = "Thêm vai trò";
}


    <div class="container-fluid py-5 px-md-5">
        <div class="card main-card p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-primary">Quản lý Role</h2>
            </div>

            <div class="form-section">
                <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Thêm Vai trò Mới</h5>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Tên vai trò</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên vai trò" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 d-flex gap-2 mt-5">
                            <button type="submit" class="btn btn-primary fw-bold px-4">
                                <i class="bi bi-save me-2"></i> Thêm role
                            </button>
                            <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                                <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

