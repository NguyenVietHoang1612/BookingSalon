@using Microsoft.AspNetCore.Identity
@model IdentityRole
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        .main-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .form-section {
            background-color: #f8faff;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .table thead th {
            background-color: #eef2ff;
            color: #4e73df;
            font-size: 0.85rem;
            text-transform: uppercase;
            padding: 15px;
        }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }

        .btn-add {
            background-color: #0d6efd;
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
        }

        .form-control {
            padding: 12px;
            font-size: 1rem;
            border-radius: 8px;
        }

        .action-icon {
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.2s;
        }

            .action-icon:hover {
                transform: scale(1.2);
            }
    </style>


    <div class="container-fluid py-5 px-md-5">
        <div class="card main-card p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-primary">Quản lý Role</h2>
            </div>

            <div class="form-section">
                <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Thêm Vai trò Mới</h5>

                <form asp-action="Update">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Tên vai trò</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên vai trò"/>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 d-flex">
                            <button type="submit" class="btn btn-primary btn-add fw-bold">
                                <i class="bi bi-plus-lg me-2"></i> Hoàn tất cập nhật
                            </button>

                            <a asp-action="Index" class="btn btn-danger fw-bold">
                                <i class="bi bi-x-lg me-2">Hủy cập nhật</i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

