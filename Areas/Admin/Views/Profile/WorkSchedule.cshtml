@using Microsoft.AspNetCore.Identity;
@using BookingSalon.Models.Entities;
@using System.Security.Claims
@inject SignInManager<UsersModel> signInManager;
@inject UserManager<UsersModel> userManager;

@{
    ViewData["Title"] = "Bảng biểu lịch làm việc";
}

@if (signInManager.IsSignedIn(User))
{
    var currentUser = await userManager.GetUserAsync(User);
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (await userManager.IsInRoleAsync(currentUser, "Stylist") || await userManager.IsInRoleAsync(currentUser, "Skinner"))
    {
        <div class="container-fluid py-4">
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-primary fw-bold">
                                <i class="bi bi-calendar3 me-2"></i>LỊCH LÀM VIỆC CỦA TÔI
                            </h5>
                            <div class="d-flex gap-2">
                                <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">
                                    <i class="bi bi-person-badge me-1"></i>Stylist: @currentUser.FullName
                                </span>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                    <i class="bi bi-clock-history me-1"></i>Sắp tới
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div id='calendar'></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="eventModalLabel"><i class="bi bi-info-circle me-2"></i>Chi tiết lịch đặt</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="modalContent">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>

        @section Styles {
            <link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
            <style>
                :root {
                    --primary-color: #4361ee;
                    --secondary-color: #3f37c9;
                    --bg-calendar: #ffffff;
                    --fc-border-color: #f1f3f5;
                    --fc-today-bg-color: rgba(67, 97, 238, 0.05); 
                }

                .card {
                    border-radius: 16px !important;
                    overflow: hidden;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
                }

                #calendar {
                    font-family: 'Inter', system-ui, -apple-system, sans-serif;
                    background: var(--bg-calendar);
                    padding: 10px;
                }

                .fc .fc-toolbar-title {
                    font-size: 1.4rem !important;
                    font-weight: 800 !important;
                    color: #2b2d42;
                    text-transform: capitalize;
                }

                .fc .fc-button-primary {
                    background-color: #f8f9fa !important;
                    border: 1px solid #e9ecef !important;
                    color: #495057 !important;
                    font-weight: 600 !important;
                    border-radius: 8px !important;
                    padding: 8px 16px !important;
                    transition: all 0.3s ease !important;
                    text-transform: none !important;
                }

                    .fc .fc-button-primary:hover {
                        background-color: #e9ecef !important;
                        color: var(--primary-color) !important;
                    }

                .fc .fc-button-active {
                    background-color: var(--primary-color) !important;
                    border-color: var(--primary-color) !important;
                    color: white !important;
                    box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3) !important;
                }

                .fc th {
                    padding: 12px 0 !important;
                    background: #fdfdfd;
                    border-bottom: 2px solid #eee !important;
                }

                .fc .fc-col-header-cell-cushion {
                    color: #495057;
                    text-decoration: none !important;
                    font-weight: 700;
                    font-size: 0.95rem;
                }

                .fc .fc-timegrid-slot {
                    height: 4.5em !important; 
                    border-bottom: 1px solid #f8f9fa !important;
                }

                .fc .fc-timegrid-slot-label-cushion {
                    font-size: 0.8rem;
                    color: #adb5bd;
                    font-weight: 500;
                }

                .fc-v-event {
                    border: none !important;
                    background: rgba(255, 255, 255, 0.95) !important;
                    border-radius: 12px !important;
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08) !important;
                    padding: 2px !important;
                    margin-left: 2px !important;
                    margin-right: 2px !important;
                }

                    .fc-v-event::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 10%;
                        height: 80%;
                        width: 4px;
                        background: var(--primary-color);
                        border-radius: 10px;
                    }

                .fc-event-main {
                    padding: 8px !important;
                }

                .fc-event-title {
                    color: #2b2d42 !important;
                    font-weight: 700 !important;
                    font-size: 0.85rem !important;
                    line-height: 1.3;
                    margin-top: 4px;
                }

                .fc-event-time {
                    display: inline-block;
                    background: rgba(67, 97, 238, 0.1);
                    color: var(--primary-color) !important;
                    padding: 2px 8px;
                    border-radius: 6px;
                    font-size: 0.75rem !important;
                    font-weight: 600;
                }

                .fc-timegrid-now-indicator-line {
                    border-color: #ff4757 !important;
                    border-width: 2px !important;
                }

                .fc-timegrid-now-indicator-arrow {
                    border-color: #ff4757 !important;
                    border-top-color: transparent !important;
                    border-bottom-color: transparent !important;
                }

                .modal-content {
                    border-radius: 20px !important;
                }

                .modal-header {
                    border-bottom: none;
                    padding: 25px 25px 10px;
                }

                .modal-body {
                    padding: 10px 25px 25px;
                }

                .detail-label {
                    color: #adb5bd;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    font-weight: 700;
                    margin-bottom: 4px;
                }

                .detail-value {
                    color: #2b2d42;
                    font-weight: 600;
                    margin-bottom: 15px;
                }
            </style>
        }

        @section Scripts {
            <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    var calendarEl = document.getElementById('calendar');
                    var eventModal = new bootstrap.Modal(document.getElementById('eventModal'));

                    var calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'timeGridWeek',
                        locale: 'vi',
                        firstDay: 1,
                        slotMinTime: '07:00:00',
                        slotMaxTime: '21:00:00',
                        slotDuration: '00:30:00',
                        nowIndicator: false,
                        allDaySlot: false,
                        stickyHeaderDates: true,
                        height: '75vh',

                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'timeGridWeek,timeGridDay'
                        },

                        buttonText: {
                            today: 'Hôm nay',
                            week: 'Tuần',
                            day: 'Ngày'
                        },


                                        events: function(info, successCallback, failureCallback) {
                    fetch('/Admin/Profile/GetStylistWorkSchedule?stylistId=@userId')
                        .then(res => res.json())
                        .then(data => {
                            console.log("Dữ liệu nhận được:", data); 
                            successCallback(data);
                        })
                        .catch(err => failureCallback(err));
                },

                        eventDidMount: function(info) {
                            let titleEl = info.el.querySelector('.fc-event-title');
                            if (titleEl) {
                                titleEl.innerHTML = info.event.title;
                            }
                        },


                        eventClick: function(info) {
                            const event = info.event;
                            const titleParts = event.title.split('|');
                            const customerName = titleParts[0] || 'Khách hàng';
                            const services = titleParts[1] || 'Chưa xác định';

                            const content = `
                                <div class="mb-3">
                                    <div class="detail-label">Khách hàng</div>
                                    <div class="fs-5 detail-value text-primary">${customerName}</div>
                                </div>
                                <div class="mb-3">
                                    <div class="detail-label">Dịch vụ</div>
                                    <div class="detail-value">${services}</div>
                                </div>
                                <div class="row bg-light p-3 rounded-4">
                                    <div class="col-6">
                                        <div class="detail-label">Bắt đầu</div>
                                        <div class="detail-value mb-0 text-success">${event.start.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</div>
                                    </div>
                                    <div class="col-6 border-start">
                                        <div class="detail-label">Kết thúc</div>
                                        <div class="detail-value mb-0">${event.end ? event.end.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '--:--'}</div>
                                    </div>
                                </div>
                            `;
                            document.getElementById('modalContent').innerHTML = content;
                            eventModal.show();
                        }
                    });

                    calendar.render();
                });
            </script>
        }
    }
}