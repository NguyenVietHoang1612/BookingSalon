@using BookingSalon.Models.Entities
@using BookingSalon.Data.Repository
@model PaginatedList<Service>

@{
    ViewData["title"] = "Danh dách dịch vụ";
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
} 

<style>
    .image-warp {
        width: 100px;
        height: 100px;
        overflow: hidden;
        border-radius: 8px;
    }
    .image-warp img {
        object-fit: cover;
        }

    
</style>


<div class="container-fluid py-2 px-md-5">
    <div class="card main-card p-2 p-lg-4">
        <div class="row align-items-center mb-5">
                <div class="col-xl-6 col-lg-5">
                    <h2 class="title-main mb-lg-0 mb-3">Quản lý dịch vụ</h2>
                </div>
                <div class="col-xl-6 col-lg-7">
                    <div class="row g-3 justify-content-lg-end">
                        <div class="col-sm-7 col-12">
                            <form asp-action="Index" method="get">
                                <div class="input-group search-group">
                                    <input type="text" value="@ViewBag.SearchTerm" name="term" class="form-control" placeholder="Tìm kiếm theo tên dịch vụ">
                                    <button type="submit" class="btn border"><i class="bi bi-search"></i></button>
                                </div>
                            </form>
                           
                        </div>
                        <div class="col-sm-5 col-12 d-grid">
                            <a class="btn btn-primary shadow-sm" asp-action="Create">
                                <i class="bi bi-plus-lg me-2"></i> Thêm dịch vụ
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px">Id</th>
                            <th>Tên dịch vụ</th>
                            <th>Loại dịch vụ</th>
                            <th>Giá dịch vụ</th>
                            <th>Thời gian thực hiện</th>
                            <th>Ảnh dịch vụ</th>
                            <th>Miêu tả</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                            @* <th class="text-center"></th>
                            <th class="text-end pe-4"></th>
                            <th class="text-end pe-4"></th> *@
                            
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.ServiceId</td>
                            <td class="fw-bold text-dark">@item.Service_Name</td>
                            <td class="text-muted">@item.TypeOfService.Type_Service_Name</td>
                            <td class="text-muted">@item.Price <trong > Vnd</trong></td>
                            <td class="text-muted">@item.DurationInMinutes phút</td>
                                <td class ="text-muted">
                                    <div class="d-flex align-content-center justify-content-center image-warp" >
                                        <img src="@(string.IsNullOrEmpty(item.ImageName)
                                        ? "https://ui-avatars.com/api/?name=" + item.Service_Name
                                        : Url.Content("~/media/services/" + item.ImageName))" class="w-100 h-100"/>
                                    </div>
                                     
                                </td>
                            <td class="text-muted">@item.description</td>
                            <td class="text-muted"> @(item.Status ? "Đang hoạt động" : "Không hoạt động")</td>
                                <td class="text-center pe-4">
                                <a asp-action="Update" asp-route-id="@item.ServiceId"><i class=" bi bi-pencil-square action-btn edit-icon"></i> </a>

                                <form id="delete-form-@item.ServiceId" asp-action="SoftDelete" asp-route-id="@item.ServiceId" method="post" style="display:inline;">
                                    <button type="button" class="btn-clean" onclick="confirmDelete('@Url.Action("SoftDelete", "ServiceSalon", new { id = item.ServiceId })', 'dịch vu @item.Service_Name')">
                                            <i class="bi bi-trash-fill text-danger action-btn"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
            </div>
            <div class="row align-items-center mt-3">
                <div class="col-sm-6 text-muted">
                    Hiển thị trang <b>@Model.PageIndex</b> / Trong tổng số <b>@Model.TotalPages</b> trang
                </div>
                <div class="col-sm-6">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-end mb-0">

                            <li class="page-item @prevDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>

                            <li class="page-item @prevDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                // Logic để chỉ hiển thị một vài số trang nếu tổng số quá lớn
                                if (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-term="@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }
                            }

                            <li class="page-item @nextDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                            <li class="page-item @nextDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
        </div>
    </div>

@section Styles {
        <link rel="stylesheet" href="~/css/Paginated.css" />
}
