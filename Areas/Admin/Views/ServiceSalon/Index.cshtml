@using BookingSalon.Models.Entities
@using BookingSalon.Data.Repository
@model PaginatedList<ServiceModel>

@{
    ViewData["title"] = "Danh dách dịch vụ";
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
} 

<div class="container-fluid py-2 px-md-5">
    <div class="card main-card p-2 p-lg-4">
        <div class="row align-items-center mb-5">
            <div class="col-xl-6 col-lg-5">
                <h2 class="title-main mb-lg-0 mb-3 fw-bold">Quản lý dịch vụ</h2>
            </div>
            <div class="col-xl-6 col-lg-7">
                <div class="row g-2 justify-content-lg-end">
                    <div class="col-sm-8 col-12">
                        <form asp-action="Index" method="get">
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <input type="text" value="@ViewBag.SearchTerm" name="term"
                                       class="form-control border-0 ps-4"
                                       placeholder="Tìm kiếm tên dịch vụ..."
                                       style="box-shadow: none;">
                                <button type="submit" class="btn btn-white bg-white border-0 pe-3 text-secondary">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                    @if(User.IsInRole("Admin"))
                    {
                        <div class="col-sm-4 col-12">
                            <a class="btn btn-primary w-100 rounded-3 shadow-sm fw-bold d-flex align-items-center justify-content-center"
                               asp-action="Create" style="padding: 0.6rem 1.5rem;">
                                <i class="bi bi-plus-lg me-2"></i> Thêm mới
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px">Id</th>
                            <th>Tên dịch vụ</th>
                            <th>Loại dịch vụ</th>
                            <th>Giá dịch vụ</th>
                            <th>Ảnh dịch vụ</th>
                            <th>Giá khuyến mãi</th>
                            <th>thời gian còn lại</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.ServiceId</td>
                                <td class="text-muted">@item.Service_Name</td>
                                <td class="text-muted">@item.TypeOfService.Type_Service_Name</td>
                                <td class="text-muted">@(item.Base_Price.ToString("#,##0") ?? "0") đ</td>
                                <td class ="text-muted">
                                    <div class="d-flex align-content-center justify-content-center image-warp" >
                                        <img src="@(string.IsNullOrEmpty(item.ImageName)
                                        ? "https://ui-avatars.com/api/?name=" + item.Service_Name
                                        : Url.Content("~/media/services/" + item.ImageName))" class="w-100 h-100"/>
                                    </div>
                                     
                                </td>
                                <td class="text-muted">@(item.Promotion_Price?.ToString("#,##0") ?? "0") đ</td>
                                <td class="text-muted">
                                   @{
                                        var remaining = item.Promotion_End - DateTime.Now;
                                    }

                                    @if (remaining.HasValue && remaining.Value.TotalSeconds > 0)
                                    {
                                        <span>@(remaining.Value.Days) ngày @(remaining.Value.Hours)h:@(remaining.Value.Minutes) phút</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">không có khuyến mãi</span>
                                    }
                                </td>
                                <td class="text-muted"> @(item.Status ? "Đang hoạt động" : "Không hoạt động")</td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Details" asp-route-id="@item.ServiceId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {

                                            <a asp-action="Update" asp-route-id="@item.ServiceId" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete('@Url.Action("SoftDelete", "ServiceSalon", new { id = item.ServiceId })', 'dịch vụ @item.Service_Name')">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                            </td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
            </div>
            <div class="row align-items-center mt-3">
                <div class="col-sm-6 text-muted">
                    Hiển thị trang <b>@Model.PageIndex</b> / Trong tổng số <b>@Model.TotalPages</b> trang
                </div>
                <div class="col-sm-6">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-end mb-0">

                            <li class="page-item @prevDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>

                            <li class="page-item @prevDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                // Logic để chỉ hiển thị một vài số trang nếu tổng số quá lớn
                                if (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-term="@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }
                            }

                            <li class="page-item @nextDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                            <li class="page-item @nextDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-term="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
        </div>
    </div>

@section Styles {
        <link rel="stylesheet" href="~/css/Paginated.css" />

        <style>
            .image-warp {
                width: 100px;
                height: 100px;
                overflow: hidden;
                border-radius: 8px;
            }

                .image-warp img {
                    object-fit: cover;
                }
        </style>
}
