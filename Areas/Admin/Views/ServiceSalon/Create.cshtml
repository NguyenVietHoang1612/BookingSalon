@using BookingSalon.Models.Entities
@model ServiceModel
@{
    ViewData["title"] = "Thêm dịch vụ";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý dịch vụ</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Thêm dịch vụ mới</h5>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Tên dịch vụ</label>
                        <input asp-for="Service_Name" class="form-control" placeholder="Nhập tên dịch vụ" />
                        <span asp-validation-for="Service_Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Loại dịch vụ</label>
                        <select asp-for="Type_Service_Id" asp-items="ViewBag.TypeOfServiceList" class="form-control" id="select-typeofservice">
                        </select>
                        <span asp-validation-for="Type_Service_Id" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Giá cơ bản dịch vụ</label>
                        <input asp-for="Base_Price" class="form-control" placeholder="Nhập giá dịch vụ" />
                        <span asp-validation-for="Base_Price" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Giá khuyến mãi</label>
                        <input asp-for="Promotion_Price" class="form-control" placeholder="Nhập giá khuyến mãi" />
                        <span asp-validation-for="Promotion_Price" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Ngày bắt đầu giảm giá</label>
                        <input type="date" asp-for="Promotion_Start" class="form-control" placeholder="Ngày giảm giá" />
                        <span asp-validation-for="Base_Price" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Ngày kết thúc giảm giá</label>
                        <input type="date" asp-for="Promotion_End" class="form-control" placeholder="Ngày hết giảm giá" />
                        <span asp-validation-for="Base_Price" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Thời gian làm dịch vụ</label>
                        <input asp-for="DurationInMinutes" class="form-control" placeholder="Nhập thời gian làm dịch vụ" />
                        <span asp-validation-for="DurationInMinutes" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Thêm ảnh dịch vụ</label>
                        <input asp-for="Service_Image_Upload" class="form-control" placeholder="Chọn ảnh" />
                        <span asp-validation-for="Service_Image_Upload" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Miêu tả</label>
                        <input asp-for="description" class="form-control" placeholder="Nhập miêu tả" />
                        <span asp-validation-for="description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select asp-for="Status" class="form-control">
                            <option value="true">dịch vụ hoạt động</option>
                            <option value="false">dịch vụ không hoạt động</option>
                        </select>

                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-5">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save me-2"></i> Thêm mới dịch vụ
                        </button>
                        <a asp-action="Index" class="btn btn-outline-danger fw-bold px-4">
                            <i class="bi bi-x-lg me-2"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script src="/js//ChoicesSelectList.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initSelectSearch('select-typeofservice', 'Chọn loại dịch vụ...')
        });
    </script>
}
