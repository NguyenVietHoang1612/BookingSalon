@model BookingSalon.Models.Entities.ServiceModel
@{
    ViewData["Title"] = "Chi tiết dịch vụ: " + Model.Service_Name;
}

<div class="container py-5">
    <article class="mx-auto" style="max-width: 800px;">
        <h1 class="fw-bold mb-3 text-primary">@Model.Service_Name</h1>

        <div class="text-muted mb-4 border-bottom pb-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-tag"></i> @(Model.TypeOfService?.Type_Service_Name ?? "Chưa phân loại")</span>
                <span class="me-3"><i class="bi bi-clock"></i> @Model.DurationInMinutes phút</span>
                <span>
                    <i class="bi bi-circle-fill @(Model.Status ? "text-success" : "text-danger")" style="font-size: 0.8rem;"></i>
                    @(Model.Status ? "Đang kinh doanh" : "Ngừng phục vụ")
                </span>
            </div>
            <div class="text-end">
                <small>Cập nhật: @Model.Update_At.ToString("dd/MM/yyyy")</small>
            </div>
        </div>

        <div class="mb-4 p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-secondary text-decoration-line-through me-2 h5 mb-0">
                    @Model.Base_Price.ToString("#,##0") VNĐ
                </span>
                <span class="text-danger fw-bold h3 mb-0">
                    @if (Model.Promotion_Price != null && Model.Promotion_Price > 0)
                    {
                        @Model.Promotion_Price?.ToString("#,##0")
                    }
                    else {
                        @Model.Base_Price.ToString("#,##0")
                    }
                     VNĐ
                </span>
            </div>
            @if (Model.Promotion_Price != null && Model.Promotion_Price > 0)
            {
                <span class="badge bg-danger">ĐANG KHUYẾN MÃI</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageName))
        {
            <div class="mb-4">
                <img src="/media/services/@Model.ImageName" alt="@Model.Service_Name" class="img-fluid rounded-3 shadow-sm w-100" />
            </div>
        }

        <div class="service-content">
            <h4 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Mô tả chi tiết</h4>
            <div class="text-secondary lead-custom">
                @if (!string.IsNullOrEmpty(Model.description))
                {
                    @Html.Raw(Model.description.Replace("\n", "<br/>"))
                }
                else
                {
                    <em>Chưa có mô tả cho dịch vụ này.</em>
                }
            </div>
        </div>

        <div class="mt-5 pt-3 border-top">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Update" asp-route-id="@Model.ServiceId" class="btn btn-warning px-4">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
            }    
            <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </article>
</div>

@section Styles {
    <style>
        .service-content {
            line-height: 1.8;
            font-size: 1.1rem;
        }

        .lead-custom {
            font-weight: 400;
            color: #4b5563;
        }

        .service-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        .text-primary {
            color: #2c3e50 !important; 
        }
    </style>
}