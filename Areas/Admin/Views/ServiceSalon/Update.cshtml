@using BookingSalon.Models.Entities
@model Service

<style>
    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .main-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .form-section {
        background-color: #f8faff;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .table thead th {
        background-color: #eef2ff;
        color: #4e73df;
        font-size: 0.85rem;
        text-transform: uppercase;
        padding: 15px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
        border-bottom: 1px solid #f0f0f0;
    }

    .btn-add {
        background-color: #0d6efd;
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
    }

    .form-control {
        padding: 12px;
        font-size: 1rem;
        border-radius: 8px;
    }

    .action-icon {
        font-size: 1.2rem;
        cursor: pointer;
        transition: 0.2s;
    }

        .action-icon:hover {
            transform: scale(1.2);
        }
</style>


<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Quản lý Role</h2>
        </div>

        <div class="form-section">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-person-plus me-2"></i>Thêm Vai trò Mới</h5>

            <form asp-action="Update" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Tên dịch vụ</label>
                            <input asp-for="Service_Name" class="form-control" placeholder="Nhập tên dịch vụ" />
                            <span asp-validation-for="Service_Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Loại dịch vụ</label>
                            <select asp-for="Type_Service" asp-items="ViewBag.TypeOfServiceList" class="form-control">
                            </select>
                            <span asp-validation-for="Type_Service" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Giá dịch vụ</label>
                            <input asp-for="Price" class="form-control" placeholder="Nhập giá dịch vụ" />
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Thời gian làm dịch vụ</label>
                            <input asp-for="DurationInMinutes" class="form-control" placeholder="Nhập thời gian làm dịch vụ" />
                            <span asp-validation-for="DurationInMinutes" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Thêm ảnh dịch vụ</label>
                            <input asp-for="Service_Image_Upload" class="form-control" placeholder="Chọn ảnh" />
                            <span asp-validation-for="Service_Image_Upload" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Miêu tả</label>
                            <input asp-for="description" class="form-control" placeholder="Nhập miêu tả" />
                            <span asp-validation-for="description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select asp-for="Status" class="form-control">
                                <option value="true">dịch vụ hoạt động</option>
                                <option value="false">dịch vụ không hoạt động</option>
                            </select>

                            <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-add fw-bold">
                                <i class="bi bi-plus-lg me-2"></i> Hoản tất cập nhật
                            </button>

                            <a asp-action="Index" class="btn btn-danger fw-bold">
                                <i class="bi bi-x-lg me-2">Hủy cập nhật</i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

