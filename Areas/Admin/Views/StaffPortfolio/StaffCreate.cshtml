@using BookingSalon.Models.Entities
@model StaffPortfolioModel

@{
    ViewData["title"] = "Thêm mới ảnh sưu tập";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5 shadow-sm border-0" style="border-radius: 15px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary"><i class="bi bi-person-plus me-2"></i>Thêm mới ảnh dịch vụ</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>

        <div class="form-section">
            <form asp-action="StaffCreate" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="row g-4 mb-5">
                    <div class="col-12 col-md-6 col-lg-4 text-center border-end">
                        <label class="form-label d-block fw-semibold">Ảnh dịch vụ</label>
                        <div class="mb-3 position-relative">
                            <img src="~/img/default-avatar.png"
                                 id="previewAvatar"
                                 class="rounded-circle img-thumbnail shadow-sm"
                                 style="width: 150px; height: 150px; object-fit: cover;" />
                        </div>
                        <div class="px-3">
                            <input asp-for="Staff_Portfolio_Image_Upload" type="file" class="form-control form-control-sm"
                                   accept="image/*" onchange="previewImage(this)" />
                            <span asp-validation-for="Staff_Portfolio_Image_Upload" class="text-danger small"></span>
                            <div class="form-text mt-2 small">Định dạng hỗ trợ: JPG, PNG, JPEG</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-8">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">tên ảnh dịch vụ <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề ảnh: vd: Underuct, Middle Part, Side Part,... " />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Loại ảnh dịch vụ</label>
                                <select asp-for="Category" class="form-control">
                                    <option value="@PortfolioCategory.Hair">Loại kiểu tóc</option>
                                    <option value="@PortfolioCategory.Skin">Loại Skin</option>
                                </select>

                                <span asp-validation-for="Category" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 d-flex gap-3 mt-5 pt-3">
                    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
                        <i class="bi bi-person-check-fill me-2"></i> Lưu ảnh sưu tập
                    </button>
                    <a asp-action="StaffIndex" class="btn btn-light fw-bold px-5 py-2 border">
                        Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-switch .form-check-input {
            width: 3.5rem !important;
            height: 1.75rem !important;
            cursor: pointer;
        }

        .custom-switch-container {
            display: flex;
            align-items: center;
            height: 38px;
        }

        .form-check-label {
            margin-left: 10px;
            cursor: pointer;
            user-select: none;
        }
    </style>

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/ChoicesSelectList.js"></script>

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewAvatar').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}