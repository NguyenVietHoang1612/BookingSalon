@using BookingSalon.Areas.Admin.Models
@model CreateStylistProfileVM

@{
    ViewData["title"] = "Thêm stylist profile";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="card-header bg-white">
            <h4 class="mb-0 fw-bold text-primary">Thêm Stylist Profile</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">Thêm thông tin chi tiết để tạo một profile mới!</p>

            <div class="d-flex justify-content-between mb-4 position-relative step-container">
                <div class="step-line"></div>
                <div class="step-item active" data-step="1">
                    <div class="step-circle">1</div>
                    <small>Bước 1<br>Nhập thông tin</small>
                </div>
                <div class="step-item" data-step="2">
                    <div class="step-circle">2</div>
                    <small>Bước 2<br>Thêm hình ảnh</small>
                </div>
                <div class="step-item" data-step="3">
                    <div class="step-circle">3</div>
                    <small>Bước 3<br>Hoàn tất</small>
                </div>
            </div>

            <form id="stylistForm" asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="step-content" id="step1">
                    <div class="mb-3 row overflow-hidden">
                        <label class="col-sm-3 col-form-label">Stylist ID *</label>
                        <div class="col-sm-9">
                            <select class="form-select" asp-for="StylistProfile.StylistId" asp-items="Model.StylistUsersSelectList">
                                <option value="">-- Chọn stylist --</option>
                            </select>
                        </div>
                        <span asp-validation-for="StylistProfile.StylistId" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Chi nhánh *</label>
                        <div class="col-sm-9">
                            <select class="form-select" asp-for="StylistProfile.Branch_Id" asp-items="Model.BranchSelectList"></select>
                        </div>
                        <span asp-validation-for="StylistProfile.Branch_Id" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Kỹ năng *</label>
                        <div class="col-sm-9"><input class="form-control" asp-for="StylistProfile.StylistSkill" /></div>
                        <span asp-validation-for="StylistProfile.StylistSkill" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Kinh nghiệm (năm)</label>
                        <div class="col-sm-9"><input class="form-control" asp-for="StylistProfile.StylistExperience" /></div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Giờ bắt đầu </label>
                        <div class="col-sm-9"><input type="time" class="form-control" asp-for="StylistProfile.Start_Work_Time" /></div>
                        <span asp-validation-for="StylistProfile.Start_Work_Time" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Giờ kết thúc </label>
                        <div class="col-sm-9"><input type="time" class="form-control" asp-for="StylistProfile.End_Work_Time" /></div>
                        <span asp-validation-for="StylistProfile.End_Work_Time" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="text-end">
                        <a asp-controller="StylistProfile" asp-action="Index" class="btn btn-danger">Hủy thêm</a>
                        <button type="button" class="btn btn-primary next-step">Tiếp theo</button>
                    </div>
                </div>

                <div class="step-content d-none" id="step2">
                    
                    <div class="mb-3">
                        <label class="form-label">Chọn hình ảnh sản phẩm (Có thể chọn nhiều)</label>
                        <input class="form-control" asp-for="ImageUploads" />    
                        <span asp-validation-for="ImageUploads" class="text-danger small mt-1 d-block" multiple></span>
                    </div>
                    <div id="imagePreviewContainer" class="d-flex flex-wrap gap-3 mb-3">
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary prev-step">Quay lại</button>
                        <button type="button" class="btn btn-primary next-step">Tiếp theo</button>
                    </div>
                </div>

                <div class="step-content d-none" id="step3">
                    <div class="alert alert-info">Vui lòng kiểm tra kỹ thông tin trước khi lưu profile.</div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary prev-step">Quay lại</button>
                        <button type="button" id="btnSubmitForm" class="btn btn-success">Lưu Profile</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Stylist/stylistProfileCreate.js"></script>
    <link href="~/css/Admin/stylistprofile.css" rel="stylesheet" />
}
