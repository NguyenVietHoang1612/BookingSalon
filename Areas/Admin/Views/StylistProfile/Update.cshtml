@using BookingSalon.Areas.Admin.Models
@model UpdateStylistProfileVM

@{
    ViewData["title"] = "Cập nhật stylist profile";
}

<div class="container-fluid py-5 px-md-5">
    <div class="card main-card p-4 p-lg-5">
        <div class="card-header bg-white">
            <h4 class="mb-0">Cập nhật Stylist Profile</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">Cập nhật thông tin chi tiết để tạo một profile mới!</p>

            <div class="d-flex justify-content-between mb-4 position-relative step-container">
                <div class="step-line"></div>
                <div class="step-item active" data-step="1">
                    <div class="step-circle">1</div>
                    <small>Bước 1<br>Cập nhật thông tin</small>
                </div>
                <div class="step-item" data-step="2">
                    <div class="step-circle">2</div>
                    <small>Bước 2<br>Cập nhật hình ảnh</small>
                </div>
                <div class="step-item" data-step="3">
                    <div class="step-circle">3</div>
                    <small>Bước 3<br>Hoàn tất</small>
                </div>
            </div>

            <form id="stylistForm" asp-action="Update" enctype="multipart/form-data" method="post">
                <div class="step-content" id="step1">
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Tên Stylist </label>
                        <div class="col-sm-9">
                            <input class="form-control"value="@Model.StylistProfile.Stylist.FullName"readonly />
                        </div>

                        <input type="hidden" asp-for="StylistProfile.StylistId" />
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Chi nhánh *</label>
                        <div class="col-sm-9">
                            <select class="form-select" asp-for="StylistProfile.Branch_Id" asp-items="Model.BranchSelectList"></select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Kỹ năng *</label>
                        <div class="col-sm-9"><input class="form-control" asp-for="StylistProfile.StylistSkill" /></div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Kinh nghiệm (năm)</label>
                        <div class="col-sm-9"><input class="form-control" asp-for="StylistProfile.StylistExperience" /></div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Giờ bắt đầu </label>
                        <div class="col-sm-9"><input type="time" class="form-control" asp-for="StylistProfile.Start_Work_Time" /></div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Giờ kết thúc </label>
                        <div class="col-sm-9"><input type="time" class="form-control" asp-for="StylistProfile.End_Work_Time" /></div>
                    </div>
                    <div class="text-end">
                        <a asp-controller="StylistProfile" asp-action="Index" class="btn btn-danger">Hủy cập nhật</a>
                        <button type="button" class="btn btn-primary next-step">Tiếp theo</button>
                    </div>
                </div>

                <div class="step-content d-none" id="step2">
                    <h5>Danh sách hình ảnh</h5>

                    <div id="imageList" class="d-flex flex-wrap gap-3 mb-3">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            <div class="image-item position-relative">
                                <img src="~/media/stylist/@Model.Images[i].ImageUrl"
                                     style="width:120px;height:120px;object-fit:cover;border-radius:6px" />

                                <input type="hidden" asp-for="Images[i].ImageId" />
                                <input type="hidden" asp-for="Images[i].ImageUrl" />
                                <input type="hidden" asp-for="Images[i].IsRemoved" class="is-removed-input" />

                                <button type="button"
                                        class="btn btn-danger btn-sm position-absolute top-0 end-0"
                                        onclick="removeImage(this)">
                                    ×
                                </button>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label>Thêm ảnh mới</label>
                        <input id="imageInput" class="form-control" type="file" asp-for="NewImageUploads" multiple accept="image/*" />
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-secondary prev-step">Quay lại</button>
                        <button type="button" class="btn btn-primary next-step">Tiếp theo</button>
                    </div>
                </div>

                <div class="step-content d-none" id="step3">
                    <div class="alert alert-info">Vui lòng kiểm tra kỹ thông tin trước khi lưu profile.</div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary prev-step">Quay lại</button>
                        <button type="submit" class="btn btn-success">Lưu Profile</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/stylist/StylistProfileUpdate.js"> </script>
    <link href="~/css/Admin/stylistprofile.css" rel="stylesheet" />
}
