@using BookingSalon.Areas.Admin.Models
@model UserUpdateViewModel
@{
    ViewData["Title"] = "Thông tin admin";
}

<div class="container-fluid py-2 px-md-5">
    <div class="card main-card p-2 p-lg-4">
        <div class="row align-items-center mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-primary">Thông tin người dùng</h2>
            </div>

            <div class="card-body">
                <form asp-action="Update" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <!-- AVATAR -->
                        <div class="col-md-4 text-center">
                            <div class="avatar-wrapper mx-auto mb-3">
                                <img src="@(string.IsNullOrEmpty(Model.User.Avatar_Name)
                                                                         ? "https://ui-avatars.com/api/?name=" + Model.User.FullName + "&size=300"
                                                                         : Url.Content("~/media/users/" + Model.User.Avatar_Name))"
                                     class="avatar-img" />
                            </div>

                            <div class="d-grid gap-2">
                                <input asp-for="User.Avatar_Image_Upload" class="form-control" />
                                <small class="text-muted">JPG, PNG ≤ 5MB</small>
                            </div>

                            <hr />

                            <h5 class="fw-bold">@Model.User.FullName</h5>
                            <p class="text-muted mb-1">
                                <i class="bi bi-geo-alt"></i> @Model.User.FullName
                            </p>
                            <p class="text-muted">
                                <i class="bi bi-envelope"></i> @Model.User.Email
                            </p>
                        </div>

                        <!-- INFO -->
                        <div class="col-md-8 ps-md-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tên admin</label>
                                <input asp-for="User.FullName" class="form-control" />
                                <span asp-validation-for="User.FullName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Email</label>
                                <input asp-for="User.Email" class="form-control" />
                                <span asp-validation-for="User.Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Địa chỉ</label>
                                <input asp-for="User.PhoneNumber" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mật khẩu</label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                            </div>

                            <div class="mb-3 d-none">
                                <label class="form-label fw-semibold">Role</label>
                                <input asp-for="User.RoleId" class="form-control" readonly/>
                            </div>

                            <div class="mt-2 pt-1">
                                <button type="submit" class="btn btn-success px-4">
                                    Cập nhật
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    .avatar-wrapper {
        width: 220px;
        height: 220px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid #dee2e6;
        background-color: #f8f9fa;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>
