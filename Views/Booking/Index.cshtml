@using Microsoft.AspNetCore.Identity;
@using BookingSalon.Models.ViewModel.BookingSalonViewModel;
@using BookingSalon.Models.Entities;
@model BookingViewModel;
@inject UserManager<Users> _userManager;
@inject SignInManager<Users> signInManager;
@if (signInManager.IsSignedIn(User)) 
{
    var currentUser = await _userManager.GetUserAsync(User);

    <div class="container-fluid bg-dark text-light min-vh-100 py-5 rounded-2">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-4 bg-secondary bg-opacity-10 rounded-4 p-4 shadow-lg border border-secondary">
                <h4 class="text-center fw-bold mb-4 text-warning">ĐẶT LỊCH GIỮ CHỖ</h4>

                <form asp-action="Index" asp-controller="Booking" method="post" id="mainBookingForm">

                    <input type="hidden" asp-for="NewBooking.Customer_Id" value="@currentUser.Id" />
                    <input type="hidden" asp-for="NewBooking.Branch_Id" id="hiddenBranchId" />
                    <input type="hidden" asp-for="NewBooking.Stylist_Id" id="hiddenStylistId" />
                    <input type="hidden" asp-for="NewBooking.Booking_Date" id="hiddenDate" />
                    <input type="hidden" asp-for="NewBooking.Slot_Id" id="hiddenSlotId" />
                    <input type="hidden" asp-for="NewBooking.Status"  value="Đang chờ xử lý"/>
                    <input type="hidden" asp-for="NewBooking.TotalPrice"/>

                    <div id="hiddenServiceInputs"></div>

                    <div class="step-container mb-4" id="step-1">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge rounded-circle bg-warning text-dark me-2">1</span>
                            <label asp-for="NewBooking.Branch_Id" class="fw-bold">Chọn salon</label>
                        </div>
                        <select id="branchSelect" class="form-select bg-dark text-light border-secondary py-3"
                                asp-items="@(new SelectList(Model.Branches, "BranchId", "Branch_Name"))">
                        </select>
                        <span asp-validation-for="NewBooking.Branch_Id" class="text-danger small"></span>
                    </div>

                    <div class="step-container mb-4 opacity-50 pe-none" id="step-2">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge rounded-circle bg-secondary me-2">2</span>
                            <label class="fw-bold">Chọn dịch vụ</label>
                        </div>
                        <div class="d-grid">
                            <button type="button" class="btn btn-outline-light text-start py-3 d-flex justify-content-between align-items-center" onclick="openServiceModal()">
                                <span id="servicePlaceholder">Anh vui lòng chọn salon trước...</span>
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                        <div id="selectedServicesList" class="mt-2 d-flex flex-wrap gap-1"></div>
                        <div id="totalPriceDisplay" class="text-warning mt-1 small fw-bold"></div>
                    </div>

                    <div class="step-container mb-4 opacity-50 pe-none" id="step-3">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge rounded-circle bg-secondary me-2">3</span>
                            <label class="fw-bold">Chọn ngày, giờ & stylist</label>
                        </div>

                        <input type="date" id="bookingDate" class="form-control bg-dark text-light border-secondary mb-3"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")">

                        <div id="stylistSlider" class="d-flex overflow-auto gap-3 pb-3 custom-scrollbar">
                        </div>

                        <div id="timeSlotContainer" class="mt-3 d-none">
                            <p class="small text-secondary mb-2">Vui lòng chọn khung giờ trống:</p>
                            <div id="slotGrid" class="d-flex flex-wrap gap-2">
                            </div>
                        </div>
                    </div>

                    <button id="btnSubmit" type="submit" class="btn btn-secondary w-100 py-3 fw-bold mt-3 disabled">
                        CHỐT GIỜ CẮT
                    </button>
                </form>      
            </div>
        </div>
    </div>

    <div class="modal fade" id="serviceModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning">Danh sách dịch vụ</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="serviceListContainer" class="row g-0 overflow-auto" style="max-height: 60vh;">
                        @foreach (var s in Model.Services)
                        {
                            <div class="col-12 border-bottom border-secondary p-3 service-item"
                                 id="item-@s.ServiceId"
                                 onclick="toggleService(@s.ServiceId, '@s.Service_Name', @s.Price)">
                                <div class="d-flex gap-3 align-items-center">
                                    <img src="~/media/services/@s.ImageName" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@s.Service_Name</h6>
                                        <span class="text-warning">@s.Price.ToString("N0") VNĐ</span>
                                    
                                    </div>
                                    <div class="form-check">
                                            <span class="text-warning">@s.DurationInMinutes.ToString() phút</span>
                                        <input class="form-check-input service-checkbox" type="checkbox"
                                               id="check-@s.ServiceId" onclick="event.stopPropagation(); toggleService(@s.ServiceId, '@s.Service_Name', @s.Price)">
                                    
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <div >
                        <div class="small text-secondary" id="modalCount">Đã chọn 0 dịch vụ</div>
                        <div class="fw-bold text-warning" id="modalTotal">0 VNĐ</div>
                    </div>
                    <button type="button" class="btn btn-warning fw-bold px-4" onclick="confirmServices()">XONG</button>
                </div>
            </div>
        </div>
    </div>

    @section Styles {
        <link rel="stylesheet" href="~/css/Customer/Booking.css" />
    }


    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/Customer/Booking.js"></script>
    }
}