@using Microsoft.AspNetCore.Identity;
@using BookingSalon.Models.ViewModel.BookingSalonViewModel;
@using BookingSalon.Models.Entities;
@model BookingViewModel;
@inject UserManager<Users> _userManager;
@inject SignInManager<Users> signInManager;
@if (signInManager.IsSignedIn(User)) 
{
    var currentUser = await _userManager.GetUserAsync(User);

<style>
    .pe-none {
        pointer-events: none;
    }

    .opacity-50 {
        opacity: 0.5;
    }
    /*service*/
    .modal-footer-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background: #1a1a1a;
        border-top: 1px solid #333;
    }

    .service-item.selected {
        background-color: rgba(255, 193, 7, 0.1);
    }

    .service-item img {
        transition: transform 0.2s;
    }

    .service-item:active img {
        transform: scale(0.95);
    }

    /* Stylist Card = */
    .stylist-item {
        min-width: 100px; 
        text-align: center;
        cursor: pointer;
        position: relative;
    }

    .stylist-avatar {
        width: 100%; 
        height: 140px; 
        border-radius: 8px; 
        object-fit: cover;
        border: 2px solid transparent;
        transition: 0.3s;
    }

    .stylist-item.active .stylist-avatar {
        border-color: #ffc107;
        box-shadow: 0 0 10px rgba(255, 193, 7, 0.5);
    }

    /* Khung giờ */
    #slotGrid {
        max-height: 180px; 
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 5px;
    }

    .slot-btn {
        border: 1px solid #444;
        color: #fff;
        background: #222;
        padding: 8px 0;
        border-radius: 4px;
        font-size: 0.9rem;
        width: 100%;
        margin-bottom: 5px;
    }

        .slot-btn.active {
            background: #fff !important;
            color: #000 !important;
            border-color: #fff;
            font-weight: bold;
        }

    /* Custom Scrollbar cho Khung giờ */
    #slotGrid::-webkit-scrollbar {
        width: 8px;
    }

    #slotGrid::-webkit-scrollbar-thumb {
        background: #ffc107;
        border-radius: 10px;
    }

    /* Stylist Scroll ngang */
    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #444;
        border-radius: 10px;
    }
</style>

<div class="container-fluid bg-dark text-light min-vh-100 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4 bg-secondary bg-opacity-10 rounded-4 p-4 shadow-lg border border-secondary">
            <h4 class="text-center fw-bold mb-4 text-warning">ĐẶT LỊCH GIỮ CHỖ</h4>

            <form asp-action="Index" asp-controller="Booking" method="post" id="mainBookingForm">

                <input type="hidden" asp-for="NewBooking.Customer_Id" value="@currentUser.Id" />
                <input type="hidden" asp-for="NewBooking.Branch_Id" id="hiddenBranchId" />
                <input type="hidden" asp-for="NewBooking.Stylist_Id" id="hiddenStylistId" />
                <input type="hidden" asp-for="NewBooking.Booking_Date" id="hiddenDate" />
                <input type="hidden" asp-for="NewBooking.Slot_Id" id="hiddenSlotId" />
                <input type="hidden" asp-for="NewBooking.Status"  value="Đang chờ xử lý"/>
                <input type="hidden" asp-for="NewBooking.TotalPrice"/>




                <div id="hiddenServiceInputs"></div>

                <div class="step-container mb-4" id="step-1">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge rounded-circle bg-warning text-dark me-2">1</span>
                        <label asp-for="NewBooking.Branch_Id" class="fw-bold">Chọn salon</label>
                    </div>
                    <select id="branchSelect" class="form-select bg-dark text-light border-secondary py-3"
                            asp-items="@(new SelectList(Model.Branches, "BranchId", "Branch_Name"))">
                        <option value="">-- Xem tất cả salon --</option>
                    </select>
                    <span asp-validation-for="NewBooking.Branch_Id" class="text-danger small"></span>
                </div>

                <div class="step-container mb-4 opacity-50 pe-none" id="step-2">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge rounded-circle bg-secondary me-2">2</span>
                        <label class="fw-bold">Chọn dịch vụ</label>
                    </div>
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-light text-start py-3 d-flex justify-content-between align-items-center" onclick="openServiceModal()">
                            <span id="servicePlaceholder">Anh vui lòng chọn salon trước...</span>
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <div id="selectedServicesList" class="mt-2 d-flex flex-wrap gap-1"></div>
                    <div id="totalPriceDisplay" class="text-warning mt-1 small fw-bold"></div>
                </div>

                <div class="step-container mb-4 opacity-50 pe-none" id="step-3">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge rounded-circle bg-secondary me-2">3</span>
                        <label class="fw-bold">Chọn ngày, giờ & stylist</label>
                    </div>

                    <input type="date" id="bookingDate" class="form-control bg-dark text-light border-secondary mb-3"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")">

                    <div id="stylistSlider" class="d-flex overflow-auto gap-3 pb-3 custom-scrollbar">
                    </div>

                    <div id="timeSlotContainer" class="mt-3 d-none">
                        <p class="small text-secondary mb-2">Vui lòng chọn khung giờ trống:</p>
                        <div id="slotGrid" class="d-flex flex-wrap gap-2">
                        </div>
                    </div>
                </div>

                <button id="btnSubmit" type="submit" class="btn btn-secondary w-100 py-3 fw-bold mt-3 disabled">
                    CHỐT GIỜ CẮT
                </button>
            </form>      
        </div>
    </div>
</div>

<div class="modal fade" id="serviceModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning">Danh sách dịch vụ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="serviceListContainer" class="row g-0 overflow-auto" style="max-height: 60vh;">
                    @foreach (var s in Model.Services)
                    {
                        <div class="col-12 border-bottom border-secondary p-3 service-item"
                             id="item-@s.ServiceId"
                             onclick="toggleService(@s.ServiceId, '@s.Service_Name', @s.Price)">
                            <div class="d-flex gap-3 align-items-center">
                                <img src="~/media/services/@s.ImageName" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@s.Service_Name</h6>
                                    <span class="text-warning">@s.Price.ToString("N0") VNĐ</span>
                                    
                                </div>
                                <div class="form-check">
                                        <span class="text-warning">@s.DurationInMinutes.ToString() phút</span>
                                    <input class="form-check-input service-checkbox" type="checkbox"
                                           id="check-@s.ServiceId" onclick="event.stopPropagation(); toggleService(@s.ServiceId, '@s.Service_Name', @s.Price)">
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer-custom">
                <div >
                    <div class="small text-secondary" id="modalCount">Đã chọn 0 dịch vụ</div>
                    <div class="fw-bold text-warning" id="modalTotal">0 VNĐ</div>
                </div>
                <button type="button" class="btn btn-warning fw-bold px-4" onclick="confirmServices()">XONG</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let bookingPayload = { branchId: null, stylistId: null, date: null, slotId: null };

        // Hàm mở Modal dịch vụ
        function openServiceModal() {
            var modalElem = document.getElementById('serviceModal');
            var modal = bootstrap.Modal.getInstance(modalElem) || new bootstrap.Modal(modalElem);
            modal.show();
        }

        // 1. Ràng buộc Bước 1 -> Bước 2
            $('#branchSelect').change(function() {
            const val = $(this).val();
            $('#hiddenBranchId').val(val);
            if (val) {
                // Cập nhật ID chi nhánh mới vào payload
                bookingPayload.branchId = val;

                // Mở khóa Bước 2
                $('#step-2').removeClass('opacity-50 pe-none');
                $('#step-2').find('.badge').addClass('bg-warning text-dark').removeClass('bg-secondary');
                $('#servicePlaceholder').text('Mời anh chọn dịch vụ...');

                // QUAN TRỌNG: Nếu người dùng đã chọn dịch vụ rồi mà đổi chi nhánh,
                // ta nên load lại danh sách stylist của chi nhánh mới ngay lập tức.
                if (selectedServices.length > 0) {
                    loadStylists(val);
                    // Reset stylist và slot đã chọn trước đó vì chúng thuộc chi nhánh cũ
                    bookingPayload.stylistId = null;
                    bookingPayload.slotId = null;
                    $('#timeSlotContainer').addClass('d-none');
                    $('#btnSubmit').addClass('disabled btn-secondary').removeClass('btn-warning text-dark shadow');
                }
            } else {
                resetFrom(2);
                $('#servicePlaceholder').text('Anh vui lòng chọn salon trước...');
            }
        });

           // Mảng lưu trữ các dịch vụ đang chọn
        let selectedServices = [];

                    function toggleService(id, name, price, duration) {
                const index = selectedServices.findIndex(s => s.id === id);
                if (index > -1) {
                    selectedServices.splice(index, 1);
                    $(`#check-${id}`).prop('checked', false);
                    $(`#item-${id}`).removeClass('selected');
                } else {
                    selectedServices.push({ id, name, price, duration }); // Lưu thêm duration
                    $(`#check-${id}`).prop('checked', true);
                    $(`#item-${id}`).addClass('selected');
                }
                updateModalSummary();
            }

        function updateModalSummary() {
            const count = selectedServices.length;
            const total = selectedServices.reduce((sum, item) => sum + item.price, 0);

            $('#modalCount').text(`Đã chọn ${count} dịch vụ`);
            $('#modalTotal').text(`${total.toLocaleString('vi-VN')} VNĐ`);
        }

        function confirmServices() {
            if (selectedServices.length === 0) {
                alert("Vui lòng chọn ít nhất 1 dịch vụ");
                return;
            }
                    let totalTime = 0;
            selectedServices.forEach(s => {
                totalTime += s.duration; 
            });
                let hiddenHtml = '';
        selectedServices.forEach((s, index) => {
            hiddenHtml += `<input type="hidden" name="BookingDetails[${index}].Service_Id" value="${s.id}" />`;
        });
        $('#hiddenServiceInputs').html(hiddenHtml);

            // 1. Hiển thị danh sách badge ra ngoài UI chính
            let htmlBadges = '';
            selectedServices.forEach(s => {
                htmlBadges += `<span class="badge bg-warning text-dark p-2 animate__animated animate__fadeIn">${s.name}</span>`;
            });
            $('#selectedServicesList').html(htmlBadges);

            // 2. Tính tổng tiền cuối cùng
            const finalTotal = selectedServices.reduce((sum, item) => sum + item.price, 0);
            $('input[name="NewBooking.TotalPrice"]').val(finalTotal);

            $('#totalPriceDisplay').html(`
                <div>Tổng thanh toán: <span class="fs-7">${finalTotal.toLocaleString('vi-VN')} VNĐ</span></div>
                <div class="text-info small">Dự kiến thực hiện: ${totalTime} phút</div>
            `);

            // 3. Mở khóa bước 3
            $('#step-3').removeClass('opacity-50 pe-none');
            $('#step-3').find('.badge').addClass('bg-warning text-dark').removeClass('bg-secondary');

            // 4. Đóng modal
            bootstrap.Modal.getInstance(document.getElementById('serviceModal')).hide();

            // 5. Load Stylist
            loadStylists(bookingPayload.branchId);
        }

        // 3. Load Stylist (AJAX)
                function loadStylists(branchId) {
            // Xóa danh sách cũ và hiện loading
            $('#stylistSlider').html('<div class="text-center w-100 py-3"><div class="spinner-border spinner-border-sm text-warning"></div></div>');

            $.get('/Booking/GetStylists', { branchId: branchId }, function(data) {
                let html = '';
                if(data && data.length > 0) {
                    // Thêm tùy chọn chọn hộ đầu tiên
                    html += `
                        <div class="stylist-item" onclick="onStylistSelect('auto', this)">
                            <img src="/media/users/default-stylist.png" class="stylist-avatar mb-1" style="filter: grayscale(1);">
                            <div class="small fw-bold">Chọn hộ anh</div>
                        </div>`;

                    data.forEach(s => {
                        html += `
                            <div class="stylist-item" onclick="onStylistSelect('${s.id}', this)">
                                <img src="/media/users/${s.img}" class="stylist-avatar mb-1" onerror="this.src='/media/users/default-stylist.png'">
                                <div class="small">${s.name}</div>
                            </div>`;
                    });
                } else {
                    html = '<div class="text-secondary small ps-2 py-3">Rất tiếc, chi nhánh này hiện chưa có stylist sẵn sàng.</div>';
                }
                $('#stylistSlider').html(html);
            }).fail(function() {
                $('#stylistSlider').html('<div class="text-danger small">Lỗi nạp dữ liệu stylist.</div>');
            });
        }

        // 4. Lazy Loading Khung giờ
        function onStylistSelect(id, el) {
            $('.stylist-item').removeClass('active');
            $(el).addClass('active');
            bookingPayload.stylistId = id;
            bookingPayload.date = $('#bookingDate').val();

            $('#timeSlotContainer').removeClass('d-none');
            $('#slotGrid').html('<div class="col-12 text-center py-3"><div class="spinner-border spinner-border-sm text-warning"></div></div>');

            $.get('/Booking/GetSlots', { stylistId: bookingPayload.stylistId, dateStr: bookingPayload.date }, function(slots) {
                let html = '';
                if(slots && slots.length > 0) {
                           slots.forEach(slot => {
            const disabled = slot.isAvailable ? '' : 'disabled';
            const opacity = slot.isAvailable ? '' : 'opacity-25';
            html += `
                <div style="width: calc(25% - 8px);">
                    <button type="button" class="btn slot-btn ${disabled} ${opacity}" onclick="onSlotSelect(${slot.slotId}, this)">
                        ${slot.time}
                    </button>
                </div>`;
        }); 
                } else {
                    html = '<div class="col-12 text-center small text-danger">Hết khung giờ trống trong ngày này.</div>';
                }
                $('#slotGrid').html(html);
            });

                $('#hiddenStylistId').val(id);

                let dateVal = $('#bookingDate').val();
                if (!dateVal) {
                    dateVal = new Date().toISOString().split('T')[0]; 
                }
                $('#hiddenDate').val(dateVal);
        }

        function onSlotSelect(id, el) {
            $('.slot-btn').removeClass('active');
            $(el).addClass('active');
            bookingPayload.slotId = id;
                $('#hiddenSlotId').val(id);
            $('#btnSubmit').removeClass('disabled btn-secondary').addClass('btn-warning text-dark shadow');
        }

                function resetFrom(step) {
            for (let i = step; i <= 3; i++) {
                $(`#step-${i}`).addClass('opacity-50 pe-none');
                $(`#step-${i}`).find('.badge').removeClass('bg-warning text-dark').addClass('bg-secondary');
            }
            // Xóa các dữ liệu đã chọn khi quay lại bước trước
            if(step <= 2) {
                selectedServices = [];
                $('#selectedServicesList').empty();
                $('#totalPriceDisplay').empty();
                // Reset modal summary
                $('#modalCount').text(`Đã chọn 0 dịch vụ`);
                $('#modalTotal').text(`0 VNĐ`);
                $('.service-checkbox').prop('checked', false);
                $('.service-item').removeClass('selected');
            }

            if(step <= 3) {
                bookingPayload.stylistId = null;
                bookingPayload.slotId = null;
                $('#stylistSlider').empty();
                $('#timeSlotContainer').addClass('d-none');
                $('#btnSubmit').addClass('disabled btn-secondary').removeClass('btn-warning text-dark shadow');
            }

                
        $('#btnSubmit').removeClass('disabled btn-secondary').addClass('btn-warning text-dark shadow');
        }


    </script>
}
}