@model BookingSalon.Models.ViewModel.BookingSalonViewModel.BookingViewModel
@using System.Security.Claims

@{
    ViewData["title"] = "Đặt lịch";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}


<div class="container py-5 d-flex justify-content-center">
    <div class="booking-container w-100">
        <h4 class="text-center text-warning fw-bold mb-4">Đặt lịch giữ chỗ</h4>

        <form asp-action="Booking" method="post" id="formBooking">
            <input type="hidden" asp-for="NewBooking.UpdatedById" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
            <input type="hidden" asp-for="NewBooking.Customer_Id" value="@userId" />
            <input type="hidden" id="rankPercent" value="@Model.RankPercent" />
            <div asp-validation-summary="All" class="text-danger"></div>

            @* Option chi nhánh *@
            <div class="step-card p-4 mb-4 shadow-sm">
                <div class="d-flex align-items-center mb-3 border-bottom border-secondary pb-2">
                    <span class="step-number">1</span>
                    <h5 class="text-warning m-0 fw-bold text-uppercase">Chọn chi nhánh</h5>
                </div>
                <select asp-for="NewBooking.Branch_Id" class="form-select bg-dark text-white border-secondary py-2" id="branchId">
                    <option value="">-- Chọn salon gần bạn --</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId">@b.Branch_Name</option>
                    }
                </select>
            </div>

            @* Chọn dịch vụ *@
            <div class="step-card p-4 mb-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary pb-2">
                    <div class="d-flex align-items-center">
                        <span class="step-number">2</span>
                        <h5 class="text-warning m-0 fw-bold text-uppercase">Chọn dịch vụ</h5>
                    </div>
                    <button type="button" class="btn btn-outline-warning btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalServices">
                        + DANH MỤC
                    </button>
                </div>
                <div id="displaySelectedServices" class="p-3 bg-black rounded border border-secondary text-secondary small italic">
                    Chưa có dịch vụ nào được chọn...
                </div>
                <div id="hiddenDetails"></div>
                <input type="hidden" asp-for="NewBooking.TotalDuration" id="totalDuration" />
                <input type="hidden" id="totalPriceInput" />

                <div class="mt-3">
                    <label class="small text-secondary">Mã giảm giá</label>

                    <div class="input-group">
                        <input type="text"
                               asp-for="CouponCode"
                               id="couponCode"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="Nhập mã coupon...">

                        <button type="button"
                                id="btnApplyCoupon"
                                class="btn btn-outline-warning">
                            Áp dụng
                        </button>


                    </div>
                    <small id="couponError" class="text-danger d-none mt-1"></small>
                    <small id="couponMessage" class="d-block mt-1"></small>

                    <input type="hidden" id="couponDiscountValue" value="0" />
                </div>
            </div>

            
            @* chọn lịch *@
            <div class="step-card p-4 mb-4 shadow-sm">
                <div class="d-flex align-items-center mb-3 border-bottom border-secondary pb-2">
                    <span class="step-number">3</span>
                    <h5 class="text-warning m-0 fw-bold text-uppercase">Stylist & Thời gian</h5>
                </div>

                <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small text-secondary">Ngày thực hiện</label>
                            <input type="date" asp-for="NewBooking.Booking_Date"
                                   id="bookingDate"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   class="form-control bg-dark text-white border-secondary">
                        </div>

                    <div id="stylistWrapper" class="staff-slider-wrapper d-none">

                        <button type="button"
                                class="slider-btn left"
                                onclick="scrollStaff('stylistContainer', -1)">
                            ❮
                        </button>

                        <div class="col-12">
                            <label class="form-label small text-secondary">Stylist</label>
                            <div id="stylistContainer" class="staff-scroll">
                                <span class="text-muted small italic">Vui lòng chọn chi nhánh...</span>
                            </div>
                            <input type="hidden" asp-for="NewBooking.Stylist_Id" id="stylistId"/>
                        </div>

                        <button type="button"
                                class="slider-btn right"
                                onclick="scrollStaff('stylistContainer', 1)">
                            ❯
                        </button>

                    </div>

                    <div id="skinnerWrapper" class="staff-slider-wrapper d-none">

                        <button type="button"
                                class="slider-btn left"
                                onclick="scrollStaff('skinnerContainer', -1)">
                            ❮
                        </button>

                        <div class="col-12">
                            <label class="form-label small text-secondary">Skinner</label>
                            <div id="skinnerContainer" class="staff-scroll">
                                <span class="text-muted small italic">Vui lòng chọn chi nhánh...</span>
                            </div>
                            <input type="hidden" asp-for="NewBooking.Skinner_Id" id="skinnerId" />
                        </div>

                        <button type="button"
                                class="slider-btn right"
                                onclick="scrollStaff('skinnerContainer', 1)">
                            ❯
                        </button>

                    </div>

                       
                </div>

                <div class="mt-4">
                    <p class="text-warning fw-bold small text-uppercase mb-3"><i class="bi bi-clock-fill"></i> Chọn khung giờ trống</p>
                    <div id="slotWrapper" class="staff-slider-wrapper d-none">

                        <button type="button"
                                class="slider-btn left"
                                onclick="scrollSlot(-1)">
                            ❮
                        </button>

                        <div id="timeSlotsArea" class="slot-scroll">
                            <span class="small text-white">Vui lòng chọn chi nhánh để hiển thị</span>
                        </div>

                        <button type="button"
                                class="slider-btn right"
                                onclick="scrollSlot(1)">
                            ❯
                        </button>
                    </div>
                    <input type="hidden" asp-for="NewBooking.Start_Slot_Id" id="startSlotId" />
                </div>
            </div>

            <div class="invoice-section p-4 shadow">
                <h4 class="text-center text-warning fw-bold mb-4">HÓA ĐƠN TẠM TÍNH</h4>
                <div id="invoiceBody" class="mb-3">
                </div>

                <div class="pt-3 border-top border-secondary">
                    <div class="invoice-row border-0">
                        <span class="text-secondary">Thời gian dự kiến:</span>
                        <span id="txtDuration" class="fw-bold text-white">0 phút</span>
                    </div>
                    <div class="invoice-row border-0">
                        <span class="text-secondary">Khuyễn mãi thành viên:</span>
                        <span id="txtRankDiscount" class="fw-bold text-success">0đ</span>
                    </div>

                    <div class="invoice-row border-0">
                        <span class="text-secondary">Giảm theo coupon:</span>
                        <span id="txtCouponDiscount" class="fw-bold text-success">0đ</span>
                    </div>

                    <div class="invoice-row border-0">
                        <span class="text-secondary">Tổng giảm:</span>
                        <span id="txtDiscount" class="fw-bold text-success">0đ</span>
                    </div>
                    <div class="invoice-row border-0 h4 mt-2">
                        <span class="fw-bold text-white">TỔNG CỘNG:</span>
                        <span id="txtTotal" class="fw-bold text-warning">0đ</span>
                    </div>
                </div>

                <div class="mt-4">
                    <textarea asp-for="NewBooking.Note" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Ghi chú thêm...">@Model.NewBooking?.Note</textarea>
                </div>
                <button type="submit" class="btn btn-warning btn-lg w-100 mt-4 fw-bold py-3 text-uppercase shadow-sm">
                    Xác nhận đặt lịch
                </button>
            </div>
        </form>
    </div>
</div>
@* Dịch vụ Modal *@
<div class="modal fade" id="modalServices" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg rounded-4">
            <div class="modal-header border-secondary py-3">
                <h5 class="modal-title d-flex align-items-center text-warning fw-bold">
                    <i class="bi bi-scissors me-2"></i> DANH MỤC DỊCH VỤ
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body bg-black p-4">
                @foreach (var type in Model.TypeOfServices)
                {
                    <div class="mb-5">
                        <h6 class="text-warning mb-4 pb-2 border-bottom border-secondary fw-bold text-uppercase" style="letter-spacing: 1px;">
                            <i class="bi bi-gem me-2"></i>@type.Type_Service_Name
                        </h6>

                        <div class="row g-3">
                            @foreach (var s in Model.Services.Where(x => x.Type_Service_Id == type.TypeOfServiceId))
                            {
                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="card h-100 bg-transparent border-secondary service-item-card rounded-3 transition-all"
                                         id="svc-@s.ServiceId"
                                         onclick="toggleService('@s.ServiceId', '@type.TypeOfServiceId', '@s.Service_Name', '@(s.IsPromotionActive? s.Promotion_Price: s.Base_Price)', '@s.DurationInMinutes')">

                                        <div class="position-relative overflow-hidden rounded-top-3">
                                            <img src="~/media/services/@s.ImageName" class="card-img-top service-img" style="height:160px; object-fit:cover;" onerror="this.src='/media/logo/BranchLogo.jpg'">
                                            <div class="position-absolute top-0 end-0 p-2">
                                                <span class="badge bg-dark bg-opacity-75 border border-secondary">
                                                    <i class="bi bi-clock me-1 text-warning"></i>@s.DurationInMinutes ph
                                                </span>
                                            </div>
                                        </div>

                                        <div class="card-body p-3 d-flex flex-column bg-dark bg-opacity-50">
                                            <h6 class="card-title fw-bold text-white mb-2">@s.Service_Name</h6>

                                            <div class="mt-auto d-flex justify-content-between align-items-end">
                                                <div>
                                                    @if (s.IsPromotionActive)
                                                    {
                                                        <div class="small text-secondary text-decoration-line-through">@((s.Base_Price).ToString("#,##0"))đ</div>
                                                        <div class="text-warning fw-bold fs-5">@(s.Promotion_Price.Value.ToString("#,##0"))đ</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-warning fw-bold fs-5">@(s.Base_Price.ToString("#,##0"))đ</div>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-outline-warning btn-sm px-3 fw-bold btn-select">
                                                    CHỌN
                                                </button>
                                            </div>
                                            <input type="radio" name="group_@type.TypeOfServiceId" class="d-none" id="radio-@s.ServiceId">
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer border-secondary bg-dark">
                <button type="button" class="btn btn-warning fw-bold px-5 py-2 rounded-pill shadow" data-bs-dismiss="modal">XÁC NHẬN</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --main-gold: #ffc107;
            --dark-bg: #0a0a0a;
            --card-bg: #161616;
            --border: #2c2c2c;
        }

        body {
            background-color: var(--dark-bg);
            color: #e0e0e0;
            font-family: 'Inter', sans-serif;
        }

        .booking-container {
            max-width: 800px;
        }

        .step-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .step-number {
            background: var(--main-gold);
            color: #000;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 10px;
        }

        .slot-btn {
            flex: 0 0 calc(20% - 10px);
            min-width: 80px;
            text-align: center;
            padding: 10px 5px;
            border: 1px solid #444;
            background: #222;
            color: #fff;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
            font-size: 0.9rem;
        }

            .slot-btn:hover:not(.disabled) {
                border-color: var(--main-gold);
                color: var(--main-gold);
            }

            .slot-btn.active {
                background: var(--main-gold) !important;
                color: #000 !important;
                font-weight: bold;
                border-color: var(--main-gold);
            }

            .slot-btn.disabled {
                opacity: 0.15;
                cursor: not-allowed;
                background: #111;
                border-color: #222;
            }

        .invoice-section {
            background: #1a1a1a;
            border: 2px solid var(--main-gold);
            border-radius: 12px;
        }

        .invoice-row {
            display: flex;
            justify-content: space-between;
            padding-bottom: 8px;
            margin-bottom: 8px;
            border-bottom: 1px dashed #333;
        }

        .staff-card {
            background: #1c1c1c;
            border: 1px solid #333;
            border-radius: 10px;
            padding: 12px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }

            .staff-card:hover {
                border-color: var(--main-gold);
                transform: translateY(-2px);
            }

            .staff-card.selected {
                border: 2px solid var(--main-gold);
                box-shadow: 0 0 10px rgba(255,193,7,0.4);
            }

        .staff-img {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 8px;
        }

        .staff-slider-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .staff-scroll {
            display: flex;
            gap: 16px;
            overflow-x: auto;
            scroll-behavior: smooth;
            padding: 10px 40px;
            flex: 1;
        }

            .staff-scroll::-webkit-scrollbar {
                display: none;
            }

        .staff-card {
            flex: 0 0 160px; 
        }

        .slider-btn {
            position: absolute;
            z-index: 10;
            background: rgba(0,0,0,0.6);
            border: 1px solid #ffc107;
            color: #ffc107;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
        }

            .slider-btn.left {
                left: 5px;
            }

            .slider-btn.right {
                right: 5px;
            }

        .slot-scroll {
            display: flex;
            flex-direction: column; 
            flex-wrap: wrap; 
            gap: 10px;
            height: 168px; 
            overflow-x: auto;
            overflow-y: hidden;
            scroll-behavior: smooth;
            padding: 10px 40px;
        }

            .slot-scroll::-webkit-scrollbar {
                display: none;
            }

        .slot-btn {
            width: 80px;
        }
    </style>

}

@section Scripts {
    <script src="/js/Customer/Booking.js"></script>
}