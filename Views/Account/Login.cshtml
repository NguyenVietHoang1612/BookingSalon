@using BookingSalon.Models.ViewModel;
@model AuthOtpViewModel;

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Đăng nhập Đặt lịch</h2>
        <p class="text-center text-muted">Nhập số điện thoại để nhận mã xác thực OTP</p>

        <form asp-action="SendOtp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                <input asp-for="PhoneNumber" class="form-control form-control-lg" 
                       placeholder="Ví dụ: 0912345678" 
                       type="tel" 
                       inputmode="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="alert alert-info small">
                <i class="fas fa-info-circle"></i> Hệ thống sẽ tự động tạo tài khoản nếu bạn chưa từng đặt lịch tại Salon.
            </div>

            <button type="submit" class="btn btn-success w-100 p-2 fw-bold">
                TIẾP TỤC & NHẬN MÃ OTP
            </button>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Home" class="text-decoration-none text-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại trang chủ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}