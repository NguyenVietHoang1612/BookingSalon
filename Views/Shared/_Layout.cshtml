<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingSalon</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookingSalon.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <div class="logo">
            <img src="~/Images/icons8-hair-96.png" alt="Travela Logo" class="logo-icon">
            <span>Travela</span>
        </div>

        <nav class="main-menu-container">
            <ul class="main-menu" id="mainMenu">
                <li class="menu-item"><a href="#" data-page="home">Trang Chủ</a></li>
                <li class="menu-item"><a href="#" data-page="about">Giới Thiệu</a></li>

                <li class="menu-item tours-dropdown">
                    <a href="#" data-page="tours">Tours <i class="fas fa-caret-down"></i></a>
                    <div class="dropdown-content tours-sub-dropdown">
                        <a href="#" class="dropdown-item" data-page="tour-type">Dịch vụ</a>
                        <a href="#" class="dropdown-item" data-page="tour-category">Stylist</a>
                    </div>
                </li>
                <li class="menu-item"><a href="#" data-page="destination">Tạo kiểu</a></li>
                <li class="menu-item"><a href="#" data-page="contact">Liên Hệ</a></li>
            </ul>
        </nav>

        <div class="actions">
            <button class="book-now-btn">Book Now ✈️</button>
            <partial name="_LoginPartial" />
        </div>

    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BookingSalon - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/js/NavbarMainCustormer.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
