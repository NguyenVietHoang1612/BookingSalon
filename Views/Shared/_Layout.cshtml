<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LuxurySalon</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Playfair+Display:ital,wght@0,900;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Paginated.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @using Microsoft.AspNetCore.Identity;
    @using BookingSalon.Models.Entities;
    @inject SignInManager<UsersModel> signInManager;
    @inject UserManager<UsersModel> userManager;

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top custom-navbar bg-black shadow">
            <div class="container">
                <a asp-area="" asp-controller="Home" asp-action="Home" class="navbar-brand fw-bold text-warning">LUXURYSALON</a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Home">Trang chủ</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Service" class="nav-link px-3">Dịch vụ</a></li>
                        <li class="nav-item"><a asp-controller="News" asp-action="Index" class="nav-link px-3">Tin tức</a></li>

                        <li class="nav-item">
                            <a class="btn btn-warning fw-bold ms-lg-3 px-4 shadow-sm" asp-controller="Booking" asp-action="Booking">ĐẶT LỊCH</a>
                        </li>

                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="min-vh-100 pt-4">
        @RenderBody()
    </main>

    <footer class="bg-black text-muted py-4 border-top border-secondary mt-5">
        <div class="container">
            @await Component.InvokeAsync("BranchFooter")
            <div class="text-center mt-3 small">
                &copy; @DateTime.Now.Year - LuxurySalon - All Rights Reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/NavbarMainCustormer.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script type="text/javascript">
    $(document).ready(function () {

        toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "5000",                  
        "showMethod": "fadeIn",
        "hideMethod": "fadeOut",
        "extendedTimeOut": "1000"
    };


        @if (TempData["Success"] != null)
        {
                    <text>toastr.success('@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
                    <text>toastr.error('@TempData["Error"]');</text>
        }
        @if (TempData["Warning"] != null)
        {
                    <text>toastr.warning('@TempData["Warning"]');</text>
        }
    });
</script>