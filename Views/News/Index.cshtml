@using BookingSalon.Models.ViewModel
@model NewsPageVM
@{
    ViewData["Title"] = "Tin Tức & Xu Hướng";
}

<section class="news-header py-5" style="background: #1a1a1a; color: white;">
    <div class="container text-center py-4">
        <h1 class="display-4 fw-bold" style="color: #c9a14a;">TIN TỨC & XU HƯỚNG</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Tin tức</li>
            </ol>
        </nav>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="row g-4">
                @if (Model.NewsList != null && Model.NewsList.Any())
                {
                    @foreach (var item in Model.NewsList)
                    {
                        <div class="col-12 mb-4">
                            <article class="news-horizontal-card row g-0 shadow-sm border rounded-3 overflow-hidden bg-white h-100">
                                <div class="col-md-5 position-relative">
                                    <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "/images/default-news.jpg" : "/media/news/" + item.Thumbnail)"
                                         class="w-100 h-100 object-fit-cover" alt="@item.Title" style="min-height: 250px;">
                                    <div class="date-badge">
                                        <span class="day">@item.PublishedDate.Day</span>
                                        <span class="month">Thg @item.PublishedDate.Month</span>
                                    </div>
                                </div>
                                <div class="col-md-7 d-flex flex-column p-4">
                                    <div class="mb-2">
                                        <span class="text-muted small ms-3"><i class="bi bi-person-fill me-1"></i> @(item.Author?.FullName ?? "Admin")</span>
                                    </div>
                                    <h3 class="fw-bold mb-3 h4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none hover-gold-title">
                                            @item.Title
                                        </a>
                                    </h3>
                                    <p class="text-muted small flex-grow-1">
                                        @item.Summary
                                    </p>
                                    <div class="mt-3">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-read-more">
                                            Đọc tiếp <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-x display-1 text-muted"></i>
                        <p class="mt-3 fs-5">Không tìm thấy bài viết nào phù hợp.</p>
                    </div>
                }
            </div>

            @if (Model.NewsList.TotalPages > 1)
            {
                <nav class="mt-5">
                    <ul class="pagination justify-content-center custom-pagination">
                        <li class="page-item @(Model.NewsList.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link shadow-none" asp-route-pageNumber="@(Model.NewsList.PageIndex - 1)" asp-route-searchTerm="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.NewsList.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.NewsList.PageIndex ? "active" : "")">
                                <a class="page-link shadow-none" asp-route-pageNumber="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.NewsList.HasNextPage ? "" : "disabled")">
                            <a class="page-link shadow-none" asp-route-pageNumber="@(Model.NewsList.PageIndex + 1)" asp-route-searchTerm="@ViewBag.SearchTerm">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>

        <div class="col-lg-4">
            <aside class="sticky-top" style="top: 100px;">
                <div class="sidebar-widget mb-5">
                    <h5 class="fw-bold widget-title mb-4">Tìm Kiếm</h5>
                    <form asp-action="Index" method="get">
                        <div class="input-group search-box shadow-sm">
                            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control border-0" placeholder="Nhập từ khóa...">
                            <button class="btn btn-white" type="submit"><i class="bi bi-search text-gold"></i></button>
                        </div>
                    </form>
                </div>

                <div class="sidebar-widget mb-5">
                    <h5 class="fw-bold widget-title mb-4">Bài Viết Mới Nhất</h5>
                    @foreach (var feat in Model.FeaturedNews)
                    {
                        <div class="d-flex mb-4 align-items-center">
                            <img src="/media/news/@feat.Thumbnail" class="rounded-circle object-fit-cover shadow-sm" style="width: 70px; height: 70px;">
                            <div class="ms-3">
                                <h6 class="mb-1 small fw-bold">
                                    <a asp-action="Details" asp-route-id="@feat.Id" class="text-decoration-none text-dark hover-gold">@feat.Title</a>
                                </h6>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i> @feat.PublishedDate.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .text-gold {
            color: #c9a14a;
        }

        .bg-gold {
            background-color: #c9a14a;
        }

        .news-horizontal-card {
            transition: all 0.3s ease;
        }

            .news-horizontal-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
            }

        .hover-gold-title:hover {
            color: #c9a14a !important;
        }

        .date-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #c9a14a;
            color: white;
            padding: 8px 12px;
            text-align: center;
            border-radius: 8px;
            line-height: 1.2;
        }

            .date-badge .day {
                font-size: 1.2rem;
                font-weight: bold;
                display: block;
            }

            .date-badge .month {
                font-size: 0.7rem;
                text-transform: uppercase;
            }

        .btn-read-more {
            color: #c9a14a;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .btn-read-more:hover {
                color: #8d6e2a;
            }

        .widget-title {
            position: relative;
            padding-bottom: 10px;
        }

            .widget-title::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 40px;
                height: 3px;
                background: #c9a14a;
            }

        .custom-pagination .page-link {
            color: #333;
            border: none;
            margin: 0 5px;
            border-radius: 5px !important;
        }

        .custom-pagination .page-item.active .page-link {
            background-color: #c9a14a;
            color: white;
        }

        .custom-pagination .page-link:hover {
            background-color: #f8f9fa;
            color: #c9a14a;
        }

        .object-fit-cover {
            object-fit: cover;
        }

        .search-box {
            background: #f8f9fa;
            padding: 5px;
            border-radius: 10px;
        }
    </style>
}